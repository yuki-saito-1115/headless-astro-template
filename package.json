{
  "name": "headless-astro-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:design-token && npm run build:openapi && run-p -l -c build:site build:preview build:storybook",
    "build:design-token": "style-dictionary build --config design-token/config.js",
    "build:openapi": "node openapi/build.js",
    "build:site": "npm run build --workspace @headless-astro-template/site",
    "build:preview": "npm run build --workspace @headless-astro-template/preview",
    "build:storybook": "npm run build --workspace @headless-astro-template/storybook",
    "dev": "run-p -l -c dev:design-token dev:site dev:preview dev:storybook",
    "dev:design-token": "chokidar design-token/**/* --command \"npm run build:design-token\"",
    "dev:site": "npm run dev --workspace @headless-astro-template/site",
    "dev:preview": "npm run dev --workspace @headless-astro-template/preview",
    "dev:storybook": "npm run dev --workspace @headless-astro-template/storybook",
    "deploy": "run-p -l -c deploy:*",
    "deploy:site": "npm run deploy --workspace @headless-astro-template/site",
    "deploy:preview": "npm run deploy --workspace @headless-astro-template/preview",
    "deploy:storybook": "npm run deploy --workspace @headless-astro-template/storybook",
    "check": "run-p -l -c check:*",
    "check:site": "npm run check --workspace @headless-astro-template/site",
    "check:preview": "npm run check --workspace @headless-astro-template/preview",
    "check:storybook": "npm run check --workspace @headless-astro-template/storybook",
    "typecheck": "run-p -l -c typecheck:*",
    "typecheck:site": "npm run check:type --workspace @headless-astro-template/site",
    "typecheck:preview": "npm run check:type --workspace @headless-astro-template/preview",
    "typecheck:storybook": "npm run check --workspace @headless-astro-template/storybook",
    "versions": "run-p -l -c versions:*",
    "versions:site": "npm run versions --workspace @headless-astro-template/site",
    "versions:preview": "npm run versions --workspace @headless-astro-template/preview",
    "versions:storybook": "npm run versions --workspace @headless-astro-template/storybook",
    "prepare": "git config core.hooksPath .hooks && git lfs install --local"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.0.0",
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/workers-types": "^5.20260917.1",
    "@markuplint/astro-parser": "^5.0.0",
    "@storybook-astro/framework": "^1.12.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/builder-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "chokidar-cli": "^3.0.0",
    "js-yaml": "^5.4.2",
    "lint-staged": "^17.5.1",
    "markuplint": "^5.0.0",
    "npm-run-all2": "^9.0.3",
    "openapi-typescript": "^7.13.0",
    "storybook": "^10.6.0",
    "style-dictionary": "^5.5.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260916.1": true
  }
}

{
  "name": "headless-astro-template",
  "version": "2026.11.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:design-token && npm run build:openapi && run-p -l -c build:site build:preview build:storybook build:docs",
    "build:design-token": "style-dictionary build --config design-token/config.js",
    "build:openapi": "node scripts/build-openapi.js",
    "build:site": "npm run build --workspace @headless-astro-template/site",
    "build:preview": "npm run build --workspace @headless-astro-template/preview",
    "build:storybook": "npm run build --workspace @headless-astro-template/storybook",
    "build:docs": "npm run build --workspace @headless-astro-template/docs",
    "dev": "run-p -l -c dev:design-token dev:site dev:preview dev:storybook dev:docs",
    "dev:design-token": "chokidar design-token/**/* --command \"npm run build:design-token\"",
    "dev:site": "npm run dev --workspace @headless-astro-template/site",
    "dev:preview": "npm run dev --workspace @headless-astro-template/preview",
    "dev:storybook": "npm run dev --workspace @headless-astro-template/storybook",
    "dev:docs": "npm run dev --workspace @headless-astro-template/docs",
    "deploy": "run-p -l -c deploy:site deploy:preview deploy:storybook deploy:docs",
    "deploy:site": "npm run deploy --workspace @headless-astro-template/site",
    "deploy:preview": "npm run deploy --workspace @headless-astro-template/preview",
    "deploy:storybook": "npm run deploy --workspace @headless-astro-template/storybook",
    "deploy:docs": "npm run deploy --workspace @headless-astro-template/docs",
    "check": "run-p -l -c check:site check:preview check:storybook check:docs check:content check:ui",
    "check:site": "npm run check --workspace @headless-astro-template/site",
    "check:preview": "npm run check --workspace @headless-astro-template/preview",
    "check:storybook": "npm run check --workspace @headless-astro-template/storybook",
    "check:docs": "npm run check --workspace @headless-astro-template/docs",
    "check:content": "npm run check --workspace @packages/content",
    "check:ui": "npm run check --workspace @packages/ui",
    "typecheck": "run-p -l -c typecheck:site typecheck:preview typecheck:storybook typecheck:docs",
    "typecheck:site": "npm run check:type --workspace @headless-astro-template/site",
    "typecheck:preview": "npm run check:type --workspace @headless-astro-template/preview",
    "typecheck:storybook": "npm run check --workspace @headless-astro-template/storybook",
    "typecheck:docs": "npm run check:type --workspace @headless-astro-template/docs",
    "versions": "run-p -l -c versions:site versions:preview versions:storybook versions:docs",
    "versions:site": "npm run versions --workspace @headless-astro-template/site",
    "versions:preview": "npm run versions --workspace @headless-astro-template/preview",
    "versions:storybook": "npm run versions --workspace @headless-astro-template/storybook",
    "versions:docs": "npm run versions --workspace @headless-astro-template/docs",
    "format": "npx biome check --write",
    "setup": "run-s -l setup:*",
    "setup:hooks": "git config core.hooksPath .hooks",
    "setup:lfs": "git lfs install --local",
    "setup:env": "node scripts/setup-env.js"
  },
  "devDependencies": {
    "@astrojs/ts-plugin": "^1.10.12",
    "@biomejs/biome": "^2.5.14",
    "@markuplint/astro-parser": "^5.0.0",
    "chokidar-cli": "^3.0.0",
    "js-yaml": "^5.4.2",
    "lint-staged": "^17.5.1",
    "markuplint": "^5.0.0",
    "npm-run-all2": "^9.0.3",
    "openapi-typescript": "^7.13.0",
    "style-dictionary": "^5.5.4",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261101.1": true
  }
}

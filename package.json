{
  "name": "headless-astro-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare:public-assets": "node scripts/prepare-public-assets.mjs",
    "build": "run-p -l -c build:*",
    "build:site": "npm run build --workspace @headless-astro-template/site",
    "build:preview": "npm run build --workspace @headless-astro-template/preview",
    "check": "run-p -l -c check:*",
    "check:site": "npm run check --workspace @headless-astro-template/site",
    "check:preview": "npm run check --workspace @headless-astro-template/preview",
    "typecheck": "run-p -l -c typecheck:*",
    "typecheck:site": "npm run check:type --workspace @headless-astro-template/site",
    "typecheck:preview": "npm run check:type --workspace @headless-astro-template/preview",
    "dev": "run-p -l -c dev:*",
    "watch:public-assets": "node scripts/prepare-public-assets.mjs --watch",
    "dev:site": "npm run prepare:public-assets -- site && run-p -l -c \"npm run watch:public-assets -- site\" \"npm run dev --workspace @headless-astro-template/site\"",
    "dev:preview": "npm run prepare:public-assets -- preview && run-p -l -c \"npm run watch:public-assets -- preview\" \"npm run dev --workspace @headless-astro-template/preview\"",
    "deploy": "run-p -l -c deploy:*",
    "deploy:site": "npm run deploy --workspace @headless-astro-template/site",
    "deploy:preview": "npm run deploy --workspace @headless-astro-template/preview",
    "versions": "run-p -l -c versions:*",
    "versions:site": "npm run versions --workspace @headless-astro-template/site",
    "versions:preview": "npm run versions --workspace @headless-astro-template/preview",
    "prepare": "git config core.hooksPath .hooks && git lfs install --local"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.14",
    "@markuplint/astro-parser": "^5.0.0",
    "lint-staged": "^17.5.1",
    "markuplint": "^5.0.0",
    "npm-run-all2": "^9.0.3",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260916.1": true
  }
}

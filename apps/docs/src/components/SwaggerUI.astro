<link
  href="https://unpkg.com/swagger-ui-dist/swagger-ui.css"
  rel="stylesheet"
/>

<div id="swagger-ui"></div>

<script
  src="https://unpkg.com/swagger-ui-dist/swagger-ui-bundle.js"
  is:inline
></script>
<script is:inline>
  window.addEventListener('load', () => {
    SwaggerUIBundle({
      dom_id: '#swagger-ui',
      url: '/openapi.yaml',
    });
  });
</script>

---
const { title, description } = Astro.props.frontmatter;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta
      content="width=device-width"
      name="viewport"
    />
    <meta
      content={description}
      name="description"
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

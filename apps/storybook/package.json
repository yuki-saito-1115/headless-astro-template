{
  "name": "@headless-astro-template/storybook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "storybook dev --port 4323",
    "build": "storybook build",
    "check": "run-p -l -c check:type check:worker",

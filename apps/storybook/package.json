    "versions": "wrangler versions upload"
  },
  "dependencies": {
    "@packages/content": "0.1.0",
    "@packages/ui": "0.1.0",
    "astro": "^7.3.3"
  },
  "devDependencies": {
    "wrangler": "^4.133.0"
  }
}

{
  "name": "@headless-astro-template/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 4321",
    "build": "astro build",
    "check": "run-p -l -c check:*",
    "check:astro": "astro check",
    "check:type": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --config wrangler.staging.jsonc",
    "versions": "wrangler versions upload",
    "versions:staging": "wrangler versions upload --config wrangler.staging.jsonc"
  },
  "dependencies": {
    "astro": "^7.3.3"
  },
  "devDependencies": {
    "wrangler": "^4.133.0"
  }
}

{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": true
  },
  "compatibility_date": "2026-09-17",
  "main": "_worker/index.ts",
  "name": "sample-staging",
  "secrets": {
    "required": [
      "CLOUDFLARE_BASIC_USER",
      "CLOUDFLARE_BASIC_PASS",
      "MICROCMS_SERVICE_DOMAIN",
      "MICROCMS_API_KEY"
    ]
  }
}

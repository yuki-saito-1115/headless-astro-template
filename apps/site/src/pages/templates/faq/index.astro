---
import Button from '@packages/ui/modules/Button/Button.astro';
import HeadingLevel2 from '@packages/ui/modules/HeadingLevel2/HeadingLevel2.astro';
import ListQuestion from '@packages/ui/modules/ListQuestion/ListQuestion.astro';
import NavigationInternal from '@packages/ui/modules/NavigationInternal/NavigationInternal.astro';
import NavigationSns from '@packages/ui/modules/NavigationSns/NavigationSns.astro';
import PanelInformation from '@packages/ui/modules/PanelInformation/PanelInformation.astro';
import Text from '@packages/ui/modules/Text/Text.astro';
import Breadcrumb from '@packages/ui/structures/Breadcrumb/Breadcrumb.astro';
import Content from '@packages/ui/structures/Content/Content.astro';
import MainVisual from '@packages/ui/structures/MainVisual/MainVisual.astro';
import Section from '@packages/ui/structures/Section/Section.astro';

import type { Props as PagePropType } from '../../../layouts/PageLayout/PageLayout.astro';
import PageLayout from '../../../layouts/PageLayout/PageLayout.astro';

const breadcrumb = [
  {
    item: '/',
    name: 'ホーム',
  },
  {
    item: '/templates/',
    name: 'テンプレート一覧',
  },
  {
    name: 'よくあるご質問',
  },
];
const pageProps: PagePropType = {
  breadcrumb,
  description: 'よくあるご質問の配置例です。',
  title: 'よくあるご質問',
};
---

<PageLayout {...pageProps}>
  <MainVisual title="よくあるご質問">
    <picture slot="media">
      <source type="image/webp" srcset="/templates/faq/images/index-mainVisual_pc.webp" media="(min-width: 768px)" width="1440" height="500" />
      <img src="/templates/faq/images/index-mainVisual_sp.webp" width="375" height="130" alt="" />
    </picture>
  </MainVisual>

  <Breadcrumb items={breadcrumb} />

  <Content>
    <Section>
      <Text>
        <p>商品・サービスに関するお客様からよくある疑問・質問への回答をご用意しております。（仮）</p>
      </Text>

      <NavigationInternal
        class="mt-8 md:mt-10"
        datas={[
          {
            href: '#faq-1',
            title: '〇〇〇〇について',
          },
          {
            href: '#faq-2',
            title: '△△△△について',
          },
          {
            href: '#faq-3',
            title: '□□□□について',
          },
        ]}
      />

      <div class="mt-8 md:mt-10" id="faq-1">
        <HeadingLevel2>
          <h2>〇〇〇〇について</h2>
        </HeadingLevel2>

        <ListQuestion
          class="mt-8 md:mt-10"
          datas={[
            {
              answer: 'そんなことはありません。私たちでは○○を用意して、○○しているから、○○のようなお客さまにも安心してお使いいただけます。そんなことはありません。私たちでは○○を用意して、○○しているから、○○のようなお客さまにも安心してお使いいただけます。',
              question: '〇〇〇〇は〇〇〇〇ですか?',
            },
            {
              answer: '回答テキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキスト',
              question: '質問テキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキスト',
            },
            {
              answer: '回答テキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキスト',
              question: '質問テキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキスト',
            },
            {
              answer: '回答テキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキスト',
              question: '質問テキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキスト',
            },
          ]}
        />
      </div>

      <div class="mt-8 md:mt-10" id="faq-2">
        <HeadingLevel2>
          <h2>△△△△について</h2>
        </HeadingLevel2>

        <ListQuestion
          class="mt-8 md:mt-10"
          datas={[
            {
              answer: 'そんなことはありません。私たちでは○○を用意して、○○しているから、○○のようなお客さまにも安心してお使いいただけます。そんなことはありません。私たちでは○○を用意して、○○しているから、○○のようなお客さまにも安心してお使いいただけます。',
              question: '〇〇〇〇は〇〇〇〇ですか?',
            },
            {
              answer: '回答テキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキスト',
              question: '質問テキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキスト',
            },
            {
              answer: '回答テキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキスト',
              question: '質問テキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキスト',
            },
            {
              answer: '回答テキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキスト',
              question: '質問テキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキスト',
            },
          ]}
        />
      </div>

      <div class="mt-8 md:mt-10" id="faq-3">
        <HeadingLevel2>
          <h2>□□□□について</h2>

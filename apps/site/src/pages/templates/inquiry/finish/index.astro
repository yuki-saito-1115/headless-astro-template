---
import Button from '@packages/ui/modules/Button/Button.astro';
import LayoutColumn from '@packages/ui/modules/LayoutColumn/LayoutColumn.astro';
import Text from '@packages/ui/modules/Text/Text.astro';
import Breadcrumb from '@packages/ui/structures/Breadcrumb/Breadcrumb.astro';
import Content from '@packages/ui/structures/Content/Content.astro';
import MainVisual from '@packages/ui/structures/MainVisual/MainVisual.astro';
import Section from '@packages/ui/structures/Section/Section.astro';

import type { Props as PagePropType } from '../../../../layouts/PageLayout/PageLayout.astro';
import PageLayout from '../../../../layouts/PageLayout/PageLayout.astro';

const breadcrumb = [
  {
    item: '/',
    name: 'ホーム',
  },
  {
    item: '/templates/',
    name: 'テンプレート一覧',
  },
  {
    name: '問い合わせフォーム（完了）',
  },
];
const pageProps: PagePropType = {
  breadcrumb,
  description: '問い合わせフォーム完了画面の配置例です。',
  title: '問い合わせフォーム（完了）',
};
---

<PageLayout {...pageProps}>
  <MainVisual title="お問い合わせありがとうございます">
    <picture slot="media">
      <source
        height="500"
        media="(min-width: 768px)"
        srcset="/templates/inquiry/images/finish-mainVisual_pc.webp"
        type="image/webp"
        width="1440"
      />
      <img
        alt=""
        height="130"
        src="/templates/inquiry/images/finish-mainVisual_sp.webp"
        width="375"
      />
    </picture>
  </MainVisual>

  <Breadcrumb items={breadcrumb} />

  <Content>
    <Section>
      <Text>
        <p>
          お問い合わせいただきありがとうございます。2～3営業日以内に、担当よりメールにて返信させていただきます。
        </p>
      </Text>

      <LayoutColumn
        class="mt-8 md:mt-10"
        columnPc="3"
        columnSp="1"
      >
        <div class="LayoutColumn__segment">
          <Button
            as="a"
            href="DUMMY_LINK"
            size="full"
            title="ホーム"
          />
        </div>

        <div class="LayoutColumn__segment">
          <Button
            as="a"
            href="DUMMY_LINK"
            size="full"
            title="リンクテキスト"
          />
        </div>

        <div class="LayoutColumn__segment">
          <Button
            as="a"
            href="DUMMY_LINK"
            size="full"
            title="リンクテキスト"
          />
        </div>

        <div class="LayoutColumn__segment">
          <Button
            as="a"
            href="DUMMY_LINK"
            size="full"
            title="リンクテキスト"
          />
        </div>

        <div class="LayoutColumn__segment">
          <Button
            as="a"
            href="DUMMY_LINK"
            size="full"
            title="リンクテキスト"
          />
        </div>

        <div class="LayoutColumn__segment">
          <Button
            as="a"
            href="DUMMY_LINK"
            size="full"
            title="リンクテキスト"
          />
        </div>

        <div class="LayoutColumn__segment">
          <Button
            as="a"
            href="DUMMY_LINK"
            size="full"
            title="リンクテキスト"
          />
        </div>

        <div class="LayoutColumn__segment">
          <Button
            as="a"
            href="DUMMY_LINK"
            size="full"
            title="リンクテキスト"
          />
        </div>

        <div class="LayoutColumn__segment">
          <Button
            as="a"
            href="DUMMY_LINK"
            size="full"
            title="リンクテキスト"
          />
        </div>
      </LayoutColumn>
    </Section>
  </Content>
</PageLayout>

---
import Badge from '@packages/ui/modules/Badge/Badge.astro';
import Button from '@packages/ui/modules/Button/Button.astro';
import FormCheckboxList from '@packages/ui/modules/FormCheckboxList/FormCheckboxList.astro';
import FormList from '@packages/ui/modules/FormList/FormList.astro';
import FormSelect from '@packages/ui/modules/FormSelect/FormSelect.astro';
import FormText from '@packages/ui/modules/FormText/FormText.astro';
import FormTextarea from '@packages/ui/modules/FormTextarea/FormTextarea.astro';
import Text from '@packages/ui/modules/Text/Text.astro';
import Breadcrumb from '@packages/ui/structures/Breadcrumb/Breadcrumb.astro';
import Content from '@packages/ui/structures/Content/Content.astro';
import MainVisual from '@packages/ui/structures/MainVisual/MainVisual.astro';
import Section from '@packages/ui/structures/Section/Section.astro';
import type { Props as PagePropType } from '../../../../layouts/PageLayout/PageLayout.astro';
import PageLayout from '../../../../layouts/PageLayout/PageLayout.astro';

const breadcrumb = [
  {
    name: 'ホーム',
    item: '/',
  },
  {
    name: 'テンプレート一覧',
    item: '/templates/',
  },
  {
    name: '問い合わせフォーム（入力）',
  },
];
const pageProps: PagePropType = {
  breadcrumb,
  description: '問い合わせフォーム入力画面の配置例です。',
  title: '問い合わせフォーム（入力）',
};
---

<PageLayout {...pageProps}>
  <MainVisual title="お問い合わせ">
    <picture slot="media">
      <source
        media="(min-width: 768px)"
        srcset="/templates/inquiry/images/entry-mainVisual_pc.webp"
        type="image/webp"
        width="1440"
        height="500"
      />
      <img
        src="/templates/inquiry/images/entry-mainVisual_sp.webp"
        width="375"
        height="130"
        alt=""
      />
    </picture>
  </MainVisual>

  <Breadcrumb items={breadcrumb} />

  <Content>
    <Section>
      <Text>
        <p>
          ご相談・お問い合わせは下記フォームをご利用ください。当社では必要に応じて、電話、メール、対面、さまざまな形式でのお打ち合わせを承っています。お気軽にお問い合わせください。（仮）
        </p>
      </Text>

      <form class="mt-8 md:mt-10">
        <FormList directSp="column" directPc="row">
          <dt>
            <label for="message">
              お問い合わせ内容 <Badge title="必須" theme="warning" />
            </label>
          </dt>
          <dd>
            <FormTextarea
              id="message"
              name="message"
              size="full"
              placeholder="ご自由にご記入ください。"
            />
          </dd>

          <dt>
            <label for="company">
              会社名 <Badge title="必須" theme="warning" />
            </label>
          </dt>
          <dd>
            <FormText
              id="company"
              name="company"
              size="full"
              placeholder="例）株式会社ミツエーリンクス"
            />
          </dd>

          <dt>
            <label for="name">
              お名前 <Badge title="必須" theme="warning" />
            </label>
          </dt>
          <dd>
            <FormText
              id="name"
              name="name"
              size="full"
              placeholder="例）山田太郎"
            />
          </dd>

          <dt>
            <label for="name-kana">
              お名前（カタカナ） <Badge title="必須" theme="warning" />
            </label>
          </dt>
          <dd>
            <FormText
              id="name-kana"
              name="name-kana"
              size="full"
              placeholder="例）ヤマダタロウ"
            />
          </dd>

          <dt>
            生年月日 <Badge title="必須" theme="warning" />
          </dt>
          <dd>
            <div class="grid grid-cols-3 gap-4">
              <FormSelect
                name="birth-year"
                options={[{ label: "選択してください", value: "" }]}
              />

              <FormSelect
                name="birth-month"
                options={[{ label: "選択してください", value: "" }]}
              />

              <FormSelect
                name="birth-day"
                options={[{ label: "選択してください", value: "" }]}
              />
            </div>
          </dd>

          <dt>
            <label for="email">
              メールアドレス <Badge title="必須" theme="warning" />
            </label>
          </dt>
          <dd>
            <FormText id="email" name="email" size="full" type="email" />
          </dd>

          <dt>
            <label for="tel">
              電話番号 <Badge title="必須" theme="warning" />
            </label>
          </dt>
          <dd>
            <FormText id="tel" name="tel" size="full" type="tel" />

            <Text class="mt-4">
              <p>
                メールアドレスの入力間違い、迷惑メール設定などにより、メールでのご連絡ができない場合がございますので、日中ご連絡が可能な電話番号をご記入ください。
              </p>
            </Text>
          </dd>

          <dt>
            <label for="postal-code">
              郵便番号 <Badge title="必須" theme="warning" />
            </label>
          </dt>
          <dd>
            <FormText id="postal-code" name="postal-code" size="full" />

            <Button
              as="button"
              class="mt-4"
              type="button"
              title="郵便番号から住所検索"
            />
          </dd>

          <dt>
            <label for="prefecture">
              都道府県 <Badge title="必須" theme="warning" />
            </label>
          </dt>
          <dd>
            <FormSelect
              id="prefecture"
              name="prefecture"
              options={[
                {
                  label: "選択してください",
                  value: "",
                },
                {
                  label: "北海道",
                  value: "北海道",
                },
                {
                  label: "東京都",
                  value: "東京都",
                },
                {
                  label: "神奈川県",
                  value: "神奈川県",
                },
                {
                  label: "大阪府",
                  value: "大阪府",
                },
                {
                  label: "福岡県",
                  value: "福岡県",
                },
                {
                  label: "沖縄県",
                  value: "沖縄県",
                },
              ]}
              size="full"
            />
          </dd>

          <dt>
            <label for="city">
              市区町村 <Badge title="必須" theme="warning" />
            </label>
          </dt>
          <dd>
            <FormText id="city" name="city" size="full" />
          </dd>

          <dt>
            <label for="address">
              番地・マンション名など <Badge title="必須" theme="warning" />
            </label>
          </dt>
          <dd>
            <FormText id="address" name="address" size="full" />
          </dd>

          <dt>当社を何で知りましたか?</dt>
          <dd>
            <FormCheckboxList
              columnPc="2"
              datas={[
                {
                  id: "source-media",
                  name: "source",
                  title: "新聞や雑誌、Webマガジンなどのメディア",
                },
                {
                  id: "source-experience",
                  name: "source",
                  title: "取引経験あり",
                },
                {
                  id: "source-referral",
                  name: "source",
                  title: "知人からの紹介",
                },
                {
                  id: "source-search",
                  name: "source",
                  title: "検索エンジン",
                },
                {
                  id: "source-other",
                  name: "source",
                  title: "その他",
                },
              ]}
            />
          </dd>
        </FormList>

        <Text class="mt-8 md:mt-10">
          <p>
            「<a href="DUMMY_LINK">プライバシーポリシー</a>
            」をお読みになり、同意いただける場合は「同意して確認画面へ」ボタンを押して、入力内容の確認画面へ進んでください。（案件に応じて必要な文章を入力する）
          </p>
        </Text>

        <div class="mt-8 md:mt-10">
          <Button
            as="button"
            type="submit"
            theme="conversion"
            title="同意して確認画面へ"
          />
        </div>
      </form>
    </Section>
  </Content>
</PageLayout>

---
import Button from '@packages/ui/modules/Button/Button.astro';
import FormList from '@packages/ui/modules/FormList/FormList.astro';
import LayoutColumn from '@packages/ui/modules/LayoutColumn/LayoutColumn.astro';
import Text from '@packages/ui/modules/Text/Text.astro';
import Breadcrumb from '@packages/ui/structures/Breadcrumb/Breadcrumb.astro';
import Content from '@packages/ui/structures/Content/Content.astro';
import MainVisual from '@packages/ui/structures/MainVisual/MainVisual.astro';
import Section from '@packages/ui/structures/Section/Section.astro';

import type { Props as PagePropType } from '../../../../layouts/PageLayout/PageLayout.astro';
import PageLayout from '../../../../layouts/PageLayout/PageLayout.astro';

const breadcrumb = [
  {
    item: '/',
    name: 'ホーム',
  },
  {
    item: '/templates/',
    name: 'テンプレート一覧',
  },
  {
    name: '問い合わせフォーム（確認）',
  },
];
const pageProps: PagePropType = {
  breadcrumb,
  description: '問い合わせフォーム確認画面の配置例です。',
  title: '問い合わせフォーム（確認）',
};
---

<PageLayout {...pageProps}>
  <MainVisual title="お問い合わせ">
    <picture slot="media">
      <source type="image/webp" srcset="/templates/inquiry/images/confirm-mainVisual_pc.webp" media="(min-width: 768px)" width="1440" height="500" />
      <img src="/templates/inquiry/images/confirm-mainVisual_sp.webp" width="375" height="130" alt="" />
    </picture>
  </MainVisual>

  <Breadcrumb items={breadcrumb} />

  <Content>
    <Section>
      <Text>
        <p>内容をご確認の上、よろしければ「送信する」ボタンを押してください。</p>
      </Text>

      <FormList class="mt-8 md:mt-10">
        <dt>お問い合わせ内容</dt>
        <dd>
          お問い合わせ内容テキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキスト
        </dd>
        <dt>会社名</dt>
        <dd>株式会社ミツエーリンクス</dd>
        <dt>お名前</dt>
        <dd>山田太郎</dd>
        <dt>お名前（カタカナ）</dt>
        <dd>ヤマダタロウ</dd>
        <dt>生年月日</dt>
        <dd>2001年1月1日</dd>
        <dt>メールアドレス</dt>
        <dd>info@mitsue.co.jp</dd>
        <dt>電話番号</dt>
        <dd>0312345678</dd>
        <dt>郵便番号</dt>
        <dd>160-6133</dd>
        <dt>都道府県</dt>
        <dd>東京都</dd>
        <dt>市区町村</dt>
        <dd>新宿区西新宿8丁目17番1号</dd>
        <dt>番地・マンション名など</dt>
        <dd>住友不動産新宿グランドタワー33階</dd>
        <dt>当社を何で知りましたか?</dt>
        <dd>新聞や雑誌、Webマガジンなどのメディア、検索エンジン</dd>
      </FormList>

      <LayoutColumn class="mt-8 justify-center md:mt-10" columnPc="auto" columnSp="1">
        <div class="LayoutColumn__segment">
          <Button type="button" title="修正する" as="button" />
        </div>

        <div class="LayoutColumn__segment">
          <Button type="submit" title="送信する" as="button" theme="conversion" />
        </div>
      </LayoutColumn>
    </Section>
  </Content>
</PageLayout>

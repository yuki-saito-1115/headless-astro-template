  },
  {
    name: '事例',
    item: '/templates/example/',
  },
  {
    name: '事例（詳細）',
  },
];
const pageProps: PagePropType = {
  breadcrumb,
  description: '事例詳細の配置例です。',
  title: '事例（詳細）',
};

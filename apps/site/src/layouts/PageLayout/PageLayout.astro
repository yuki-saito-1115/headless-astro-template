---
import '@packages/content/styles/tailwind.css';
import type { BreadcrumbItem } from '@packages/ui/structures/Breadcrumb/Breadcrumb.astro';
import Footer from '@packages/ui/structures/Footer/Footer.astro';
import Header from '@packages/ui/structures/Header/Header.astro';
import NavigationTop from '@packages/ui/structures/NavigationTop/NavigationTop.astro';
import Wrap from '@packages/ui/structures/Wrap/Wrap.astro';

/* ページごとに設定が必要な値 */
export interface Props {
  breadcrumb?: BreadcrumbItem[];
  description: string;
  lang?: string;
  ogImage?: string;
  ogLocale?: string;
  ogType?: string;
  title?: string; // TOPページは省略
}

const siteName = 'DUMMY_SITE_NAME';
const siteUrl = 'https://playground.demo.mitsue.com';
const currentUrl = new URL(Astro.url);

// ページコンポーネントから受け取ったデータを展開する
const {
  breadcrumb = [],
  lang = 'ja',
  title,
  description,
  ogType = 'website',
  ogLocale = 'ja_JP',
  ogImage = `${siteUrl}/ogp.webp`,
}: Props = Astro.props as Props;

// ページデータをもとにページタイトルを生成する
const pageTitle = title ? `${title} | ${siteName}` : siteName;
// パンくずリストをJSON-LDとして出力する
const jsonLd = breadcrumb.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumb.map((item, index) => ({
        '@type': 'ListItem',
        item: item.item,
        name: item.name,
        position: index + 1,
      })),
    }
  : undefined;

// JSON-LD内の文字列でscript要素が意図せず閉じられないようにする
const jsonLdText = jsonLd && JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta
      content="width=device-width, initial-scale=1"
      name="viewport"
    />

    <title>{pageTitle}</title>

    <meta
      content={siteName}
      property="og:site_name"
    />
    <meta
      content={ogType}
      property="og:type"
    />
    <meta
      content={pageTitle}
      property="og:title"
    />
    <meta
      content={description}
      property="og:description"
    />
    <meta
      content={`${siteUrl}${currentUrl.pathname}`}
      property="og:url"
    />
    <meta
      content={ogLocale}
      property="og:locale"
    />
    <meta
      content={ogImage}
      property="og:image"
    />
    <meta
      content={description}
      name="description"
    />
    <meta
      content="telephone=no"
      name="format-detection"
    />
    <meta
      content="summary"
      name="twitter:card"
    />
    <meta
      content={ogImage}
      name="twitter:image"
    />

    {jsonLdText && (
      <script
        set:html={jsonLdText}
        type="application/ld+json"
      ></script>
    )}
  </head>

  <body>
    <Wrap>
      <Header />

      <slot />

      <NavigationTop />

      <Footer />
    </Wrap>

    <script>
      import { loadFonts } from '@packages/content/runtime/loadFonts';

      loadFonts();
    </script>
  </body>
</html>

---
import {
  getSampleDetail,
  getSampleList,
} from '@packages/content/build/getSample';
import SampleDetail from '@packages/ui/microCMS/sample/SampleDetail.astro';
import Heading2 from '@packages/ui/modules/Heading2/Heading2.astro';
import type { BreadcrumbListItemType } from '@packages/ui/structures/Breadcrumb/Breadcrumb.astro';
import Breadcrumb from '@packages/ui/structures/Breadcrumb/Breadcrumb.astro';
import Content from '@packages/ui/structures/Content/Content.astro';
import Section from '@packages/ui/structures/Section/Section.astro';
import type { PagePropsType } from '../../../layouts/PageLayout/PageLayout.astro';
import PageLayout from '../../../layouts/PageLayout/PageLayout.astro';

const draftKey = Astro.url.searchParams.get('draftKey');

export async function getStaticPaths() {
  const samples = await getSampleList();

  return samples
    .filter((sample) => !!sample.id)
    .map((sample) => ({
      params: { slug: sample.id },
    }));
}

const sample = await getSampleDetail(Astro.params.slug, {
  draftKey,
});
const breadcrumb: BreadcrumbListItemType[] = [
  {
    name: 'ホーム',
    item: '/',
  },
  {
    name: '羅生門',
  },
];
const pageProps: PagePropsType = {
  breadcrumb,
  description: 'DUMMY_DESCRIPTION',
};
---

<PageLayout {...pageProps}>
  <Breadcrumb items={breadcrumb} />

  <Content>
    <Section>
      <Heading2><h2>記事詳細サンプル</h2></Heading2>

      <SampleDetail
        sample={sample}
        contentId={sample.id}
        draftKey={draftKey}
      />
    </Section>
  </Content>
</PageLayout>

---
import PageLayout from '../layouts/PageLayout/PageLayout.astro';

const title = 'Headless Astro Template';
const description = 'Shared Astro app skeleton for Cloudflare Workers monorepos.';
---

<PageLayout title={title} description={description}>
  <main>
    <p>Static Worker</p>
    <h1>{title} - preview environment</h1>
    <p>{description}</p>
  </main>
</PageLayout>

---
import type { HTMLAttributes } from 'astro/types';

/**
 * テキストを簡潔に示すラベルです。
 */
export interface Props extends HTMLAttributes<'a' | 'span'> {
  /** テキストノード以外は指定できません。 */
  label: string;
  /** 塗りと線の配色を逆転します。 */
  outline?: boolean;
  /** 角丸または楕円の形状を設定します。 */
  shape?: 'rounded' | 'pill';
  /** 注意または警告を示す配色を設定します。 */
  theme?: 'caution' | 'warning';
  /** リンク先を設定します。指定すると `a` 要素を出力します。 */
  href?: string;
}

const {
  label,
  outline = false,
  shape = undefined,
  theme = undefined,
  href,
  class: className,
  ...rest
} = Astro.props;
const Element = href ? 'a' : 'span';
const classList = ['Badge'];
let mergedClass = '';

if (theme) {
  classList.push(`theme-${theme}`);
}

if (shape) {
  classList.push(`shape-${shape}`);
}

if (outline) {
  classList.push('theme-outline');
}

mergedClass = classList.join(' ');
---

<Element
  class:list={[mergedClass, className]}
  href={href}
  {...rest}
>
  {label}
</Element>


<style>
  .Badge {
    --local-foreground: var(--user-color-foreground-light);
    --local-background: var(--user-color-background-dark);
    --local-outline: var(--local-background);

    background-color: var(--local-background);
    border: 1px solid var(--local-outline);
    color: var(--local-foreground);
    display: inline-block;
    font-size: var(--text-xs);
    line-height: 1;
    outline: none;
    padding: calc(var(--user-spacing) * 2) calc(var(--user-spacing) * 4);

    /* 角丸 */
    &:where(.shape-rounded) {
      border-radius: var(--radius-md);
    }

    /* 楕円 */
    &:where(.shape-pill) {
      border-radius: 9999px;
    }

    /* 注意 */
    &:where(.theme-caution) {
      --local-background: var(--user-color-warning-dark);
    }

    /* 警告 */
    &:where(.theme-warning) {
      --local-background: var(--user-color-danger-dark);
    }

    /* 罫線 */
    &:where(.theme-outline) {
      --local-foreground: var(--user-color-foreground-dark);
      --local-background: var(--user-color-background-light);
      --local-outline: var(--local-foreground);

      &:where(.theme-caution) {
        --local-foreground: var(--user-color-warning-dark);
      }

      &:where(.theme-warning) {
        --local-foreground: var(--user-color-danger-dark);
      }
    }

    /* インタラクティブ要素の場合 */
    &:where(
      [href],
      input:not([type='hidden']),
      select,
      textarea,
      button,
      iframe,
      object,
      embed,
      video,
      audio,
      summary,
      [tabindex]:not([tabindex='-1'])
    ) {
      text-decoration: none;

      &:hover,
      &:focus {
        --local-foreground: var(--user-color-foreground-dark);
        --local-background: var(--user-color-background-light);
        --local-outline: var(--local-foreground);

        text-decoration: none;

        /* 注意 */
        &:where(.theme-caution) {
          --local-foreground: var(--user-color-warning-dark);
        }

        /* 警告 */
        &:where(.theme-warning) {
          --local-foreground: var(--user-color-danger-dark);
        }

        /* 罫線 */
        &:where(.theme-outline) {
          --local-foreground: var(--user-color-foreground-light);
          --local-background: var(--user-color-background-dark);
          --local-outline: var(--local-background);

          /* 注意 */
          &:where(.theme-caution) {
            --local-background: var(--user-color-warning-dark);
          }

          /* 警告 */
          &:where(.theme-warning) {
            --local-background: var(--user-color-danger-dark);
          }
        }
      }
    }
  }
</style>

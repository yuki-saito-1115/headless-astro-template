---
import type { Polymorphic } from 'astro/types';

/**
 * - __このコンポーネントはMarkdown実装やリッチエディタ上では利用できません。__
 * - このコンポーネントは原則として単品での利用を想定していません。`BadgeList` コンポーネントを使用してください。
 */
export type Props<Tag extends 'span' | 'a' | 'button' = 'span' | 'a' | 'button'> = Tag extends 'span' | 'a' | 'button'
  ? Polymorphic<{
      as: Tag;
    }> & {
      /** 出力する要素を設定します。要素を選択すると、その要素の属性を指定できます。 */
      as?: Tag;
      /** テキストノード以外は指定できません。 */
      title: string;
      /** 塗りと線の配色を逆転します。 */
      outline?: boolean;
      /** 角丸または楕円の形状を設定します。 */
      shape?: 'rounded' | 'pill';
      /** 配色を設定できます。セマンティクスに変化はありません。 */
      theme?: 'caution' | 'warning';
    }
  : never;

const { as: Element = 'span', title, outline = false, shape = undefined, theme = undefined, class: className, ...rest } = Astro.props;
const attrs: Record<string, unknown> = {
  ...rest,
};

switch (Element) {
  case 'a':
    delete attrs.disabled;
    delete attrs.type;
    break;
  case 'button':
    delete attrs.download;
    delete attrs.href;
    break;
  default:
    delete attrs.disabled;
    delete attrs.download;
    delete attrs.href;
    delete attrs.type;
    break;
}
---

<Element
  class:list={[
    'Badge',
    theme && `theme-${theme}`,
    shape && `shape-${shape}`,
    outline && 'theme-outline',
    className,
  ]}
  {...attrs}
>
  {title}
</Element>

<style>
  .Badge {
    --local-foreground: var(--user-color-foreground-light);
    --local-background: var(--user-color-secondary2);
    --local-outline: transparent;
    display: inline-flex;

    align-items: center;
    justify-content: center;
    padding: calc(var(--user-spacing) * 2) calc(var(--user-spacing) * 4);
    /* button要素はフォントを継承しないため */
    font: inherit;
    font-size: var(--text-xs);
    line-height: var(--user-line-height);
    color: var(--local-foreground);
    /* button要素は文字間隔を継承しないため */
    letter-spacing: inherit;
    outline: none;
    background-color: var(--local-background);
    border: 1px solid var(--local-outline);

    /* 角丸 */
    &:where(.shape-rounded) {
      border-radius: var(--radius-md);
    }

    /* 楕円 */
    &:where(.shape-pill) {
      border-radius: 9999px;
    }

    /* 注意 */
    &:where(.theme-caution) {
      --local-background: var(--user-color-warning-dark);

      &:where(.theme-outline) {
        --local-foreground: var(--user-color-warning-dark);
        --local-outline: var(--user-color-warning-dark);
      }
    }

    /* 警告 */
    &:where(.theme-warning) {
      --local-background: var(--user-color-danger-dark);

      &:where(.theme-outline) {
        --local-foreground: var(--user-color-danger-dark);
        --local-outline: var(--user-color-danger-dark);
      }
    }

    /* 罫線 */
    &:where(.theme-outline) {
      --local-foreground: var(--user-color-foreground-dark);
      --local-background: var(--user-color-background-light);
      --local-outline: var(--user-color-secondary2);
    }

    /* インタラクティブ要素の場合 */
    &:where([href], button) {
      text-decoration: none;
    }
  }

  @media (width >= 768px) {
    .Badge {
      font-size: calc(var(--user-font-size-base) * 0.8125);
    }
  }

  @media (any-hover: hover) {
    .Badge:not(span, :disabled) {
      &:hover {
        --local-foreground: var(--user-color-foreground-dark);
        --local-background: var(--user-color-background-light);
        --local-outline: var(--local-foreground);

        text-decoration: none;

        /* 注意 */
        &:where(.theme-caution) {
          --local-foreground: var(--user-color-warning-dark);

          &:where(.theme-outline) {
            --local-background: var(--user-color-warning-dark);
            --local-outline: var(--user-color-warning-dark);
          }
        }

        /* 警告 */
        &:where(.theme-warning) {
          --local-foreground: var(--user-color-danger-dark);

          &:where(.theme-outline) {
            --local-background: var(--user-color-danger-dark);
            --local-outline: var(--user-color-danger-dark);
          }
        }

        /* 罫線 */
        &:where(.theme-outline) {
          --local-foreground: var(--user-color-foreground-light);
          --local-background: var(--user-color-background-dark);
          --local-outline: var(--local-background);
        }
      }
    }
  }
</style>

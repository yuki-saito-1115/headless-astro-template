---
import type { HTMLAttributes, Polymorphic } from 'astro/types';

/**
 * - __このコンポーネントはMarkdown実装やリッチエディタ上では利用できません。__
 */
export type Props<Tag extends 'div' | 'li' = 'div' | 'li'> = Polymorphic<{
  as: Tag;
}> & {
  /** 出力する要素を設定します。要素を選択すると、その要素の属性を指定できます。省略すると `"div"` になります。 */
  as?: Tag;
  /** 外枠を表示します。 */
  outline?: boolean;
  /** SP幅時の画像とテキストの並び方向を設定します。 */
  directSp?: 'row' | 'row-reverse' | 'column' | 'column-reverse';
  /** PC幅時の画像とテキストの並び方向を設定します。 */
  directPc?: 'row' | 'row-reverse' | 'column' | 'column-reverse';
  /** 配色を設定できます。セマンティクスに変化はありません。 */
  theme?: 'caution' | 'warning';
  /** タイトルを設定できます。`Column` コンポーネント内では、同じ行に並ぶ `Card` 同士で有無を揃えてください。混在すると高さ揃えがずれます。 */
  title?: string;
  /** 日付を設定できます。`Column` コンポーネント内では、同じ行に並ぶ `Card` 同士で有無を揃えてください。混在すると高さ揃えがずれます。 */
  date?: string;
  /** カード全体をリンクにする場合の属性を指定します。 */
  link?: HTMLAttributes<'a'>;
};

const {
  as: Element = 'div',
  outline = false,
  directSp = 'column',
  directPc = 'column',
  theme = undefined,
  class: className,
  title,
  date,
  link,
  ...rest
} = Astro.props;
const attrs: Record<string, unknown> = {
  ...rest,
};
const { class: linkClassName, ...linkRest } = link ?? {};
const linkAttrs: Record<string, unknown> = {
  ...linkRest,
};
const WrapElement = link ? 'a' : 'span';
---

<Element
  class:list={[
    'Card',
    theme && `theme-${theme}`,
    outline && 'theme-outline',
    className,
  ]}
  {...attrs}
>
  <WrapElement
    class:list={[
      'Card__wrap',
      link && 'Card__link',
      `directSp-${directSp}`,
      `directPc-${directPc}`,
      linkClassName,
    ]}
    {...linkAttrs}
  >
    {Astro.slots.has('media') && (
      <div
        class:list={[
          'Card__media',
        ]}
      >
        {/* @slot このslotの中では、[Media](/?path=/docs/components-media-media--docs) コンポーネントの使用のみを許容します。 */}
        <slot name="media" />
      </div>
    )}

    {title && (
      <div
        class:list={[
          'Card__title',
        ]}
      >
        {title}
      </div>
    )}

    <div
      class:list={[
        'Card__content',
      ]}
    >
      {/* @slot このslotの中では、あらゆるコンポーネント・HTML要素・テキストノードの使用を許容します。 */}
      <slot name="content" />
    </div>

    {date && (
      <div
        class:list={[
          'Card__date',
        ]}
      >
        {date}
      </div>
    )}
  </WrapElement>
</Element>

<style>
  .Card {
    --local-padding: calc(var(--user-spacing) * 4);
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 4;
    gap: var(--local-padding);

    align-content: start;
    height: 100%;

    &:where(.theme-caution, .theme-warning, .theme-outline) {
      padding: var(--local-padding);
    }

    /* 注意 */
    &:where(.theme-caution) {
      background-color: var(--user-color-warning-light);
    }

    /* 警告 */
    &:where(.theme-warning) {
      background-color: var(--user-color-danger-light);
    }

    /* 罫線 */
    &:where(.theme-outline) {
      border: 1px solid var(--user-color-outline-light);
    }
  }

  .Card__media {
    position: relative;
    width: 100%;

    :where(img) {
      display: block;
      width: 100%;
      max-width: none;
      height: auto;
    }
  }

  .Card__wrap {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: 1 / span 4;
    grid-column: 1;
    gap: var(--local-padding);
    align-content: start;
    height: 100%;
  }

  .Card__link {
    color: var(--user-color-foreground-dark);
    text-decoration: none;

    :where(.Card__title) {
      color: var(--user-color-primary);
    }
  }

  .Card__title {
    font-size: var(--user-font-size-base);
    font-weight: var(--user-font-weight-bold);
    line-height: var(--user-line-height);
  }

  .Card__date {
    font-size: var(--text-xs);
  }

  @media (width < 768px) {
    .Card__wrap {
      &:where(.directSp-row) {
        grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);

        :where(.Card__media) {
          grid-row: 1 / span 4;
          grid-column: 1;
        }

        :where(.Card__title, .Card__content, .Card__date) {
          grid-column: 2;
        }
      }

      &:where(.directSp-row-reverse) {
        grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);

        :where(.Card__media) {
          grid-row: 1 / span 4;
          grid-column: 2;
        }

        :where(.Card__title, .Card__content, .Card__date) {
          grid-column: 1;
        }
      }

      &:where(.directSp-column-reverse) {
        :where(.Card__media) {
          grid-row: 4;
        }
      }
    }
  }

  @media (width >= 768px) {
    .Card {
      --local-padding: calc(var(--user-spacing) * 6);
    }

    .Card__title {
      font-size: var(--text-lg);
    }

    .Card__date {
      font-size: var(--user-font-size-note);
    }

    .Card__wrap {
      &:where(.directPc-row) {
        grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);

        :where(.Card__media) {
          grid-row: 1 / span 4;
          grid-column: 1;
        }

        :where(.Card__title, .Card__content, .Card__date) {
          grid-column: 2;
        }
      }

      &:where(.directPc-row-reverse) {
        grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);

        :where(.Card__media) {
          grid-row: 1 / span 4;
          grid-column: 2;
        }

        :where(.Card__title, .Card__content, .Card__date) {
          grid-column: 1;
        }
      }

      &:where(.directPc-column-reverse) {
        :where(.Card__media) {
          grid-row: 4;
        }
      }
    }
  }

  @media (any-hover: hover) {
    .Card__link {
      &:hover {
        > :where(.Card__media, .Card__title, .Card__content, .Card__date) {
          opacity: 0.5;
        }
      }
    }
  }
</style>

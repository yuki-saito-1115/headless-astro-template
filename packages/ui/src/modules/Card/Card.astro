---
import type { HTMLAttributes, Polymorphic } from 'astro/types';

/**
 * - __このコンポーネントはMarkdown実装やリッチエディタ上では利用できません。__
 */
export type Props<Tag extends 'div' | 'li' = 'div' | 'li'> = Polymorphic<{
  as: Tag;
}> & {
  /** 出力する要素を設定します。要素を選択すると、その要素の属性を指定できます。省略すると `"div"` になります。 */
  as?: Tag;
  /** 外枠を表示します。 */
  outline?: boolean;
  /** SP幅時の画像とテキストの並び方向を設定します。 */
  directSp?: 'row' | 'row-reverse' | 'column' | 'column-reverse';
  /** PC幅時の画像とテキストの並び方向を設定します。 */
  directPc?: 'row' | 'row-reverse' | 'column' | 'column-reverse';
  /** 配色を設定できます。セマンティクスに変化はありません。 */
  theme?: 'caution' | 'warning';
  /** タイトルを設定できます。`Column` コンポーネント内では、同じ行に並ぶ `Card` 同士で有無を揃えてください。混在すると高さ揃えがずれます。 */
  title?: string;
  /** 日付を設定できます。`Column` コンポーネント内では、同じ行に並ぶ `Card` 同士で有無を揃えてください。混在すると高さ揃えがずれます。 */
  date?: string;
  /** 画像を設定できます。 */
  media: HTMLAttributes<'img'>;
};

const {
  as: Element = 'div',
  outline = false,
  directSp = 'column',
  directPc = 'column',
  theme = undefined,
  class: className,
  title,
  date,
  media,
  ...rest
} = Astro.props;
const attrs: Record<string, unknown> = { ...rest };
---
<Element
  class:list={[
    'Card',
    theme && `theme-${theme}`,
    outline && 'theme-outline',
    `directSp-${directSp}`,
    `directPc-${directPc}`,
    className,
  ]}
  {...attrs}
>
  <div class:list={['Card__media']}>
    <img class:list={['Card__mediaItem']} {...media}>
  </div>

  {title && <div class:list={['Card__title']}>{title}</div>}

  <div class:list={['Card__body']}>
    <slot />
  </div>

  {date && <div class:list={['Card__date']}>{date}</div>}
</Element>


<style>
  .Card {
    gap: calc(var(--user-spacing) * 4);
    display: grid;
    grid-row: span 4;
    grid-template-rows: subgrid;

    &:where(.theme-caution, .theme-warning, .theme-outline) {
      padding: calc(var(--user-spacing) * 4);
    }

    /* 注意 */
    &:where(.theme-caution) {
      background-color: var(--user-color-warning-dark);
    }

    /* 警告 */
    &:where(.theme-warning) {
      background-color: var(--user-color-danger-dark);
    }

    /* 罫線 */
    &:where(.theme-outline) {
      border: 1px solid var(--user-color-outline-light);
    }
  }

  .Card__media {
    width: 100%;
    position: relative;

    :where(img) {
      display: block;
      max-width: none;
      width: 100%;
      height: auto;
    }
  }

  .Card__title {
    font-weight: var(--user-font-weight-bold);
    line-height: var(--user-line-height);
    font-size: var(--text-sm);
  }

  .Card__date {
    font-size: var(--text-xs);
  }

  @media (width < 768px) {
    .Card {
      &:where(.directSp-row) {
        grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);

        :where(.Card__media) {
          grid-column: 1;
          grid-row: 1 / span 4;
        }

        :where(.Card__title, .Card__body, .Card__date) {
          grid-column: 2;
        }
      }

      &:where(.directSp-row-reverse) {
        grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);

        :where(.Card__media) {
          grid-column: 2;
          grid-row: 1 / span 4;
        }

        :where(.Card__title, .Card__body, .Card__date) {
          grid-column: 1;
        }
      }

      &:where(.directSp-column-reverse) {
        :where(.Card__media) {
          grid-row: 4;
        }
      }
    }
  }

  @media (width >= 768px) {
    .Card {
      &:where(.directPc-row) {
        grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);

        :where(.Card__media) {
          grid-column: 1;
          grid-row: 1 / span 4;
        }

        :where(.Card__title, .Card__body, .Card__date) {
          grid-column: 2;
        }
      }

      &:where(.directPc-row-reverse) {
        grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);

        :where(.Card__media) {
          grid-column: 2;
          grid-row: 1 / span 4;
        }

        :where(.Card__title, .Card__body, .Card__date) {
          grid-column: 1;
        }
      }

      &:where(.directPc-column-reverse) {
        :where(.Card__media) {
          grid-row: 4;
        }
      }
    }
  }
</style>

---
import type { HTMLAttributes } from 'astro/types';

/**
 * - __このコンポーネントはMarkdown実装やリッチエディタ上では利用できません。__
 */
export interface Props extends HTMLAttributes<'div'> {}

const { class: className, ...rest } = Astro.props;
const attrs: Record<string, unknown> = {
  ...rest,
};

if (!Astro.slots.has('default')) {
  throw new Error('TextLead: slotの中身が空です。');
}
---

<div
  class:list={[
    'TextLead',
    className,
  ]}
  {...attrs}
>
  {/* @slot このslotの直下では、クラス名無しの `div` 要素または `p` 要素の使用のみを許容します。 */}
  <slot />
</div>

<style>
  .TextLead {
    display: flex;
    flex-direction: column;
    gap: calc(var(--user-spacing) * 4);
    font-size: var(--text-lg);
    font-weight: var(--user-font-weight-bold);
    line-height: var(--user-line-height);

    :where(div, p) {
      flex: 0 0 auto;
      font-weight: bold;
    }
  }

  @media (width >= 768px) {
    .TextLead {
      font-size: var(--text-xl);
    }
  }
</style>

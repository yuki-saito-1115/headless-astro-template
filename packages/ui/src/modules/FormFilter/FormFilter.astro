---
import type { HTMLAttributes } from 'astro/types';

/**
 * - __このコンポーネントはMarkdown実装やリッチエディタ上では利用できません。__
 */
export interface Props extends HTMLAttributes<'dl'> {}

const { class: className, ...rest } = Astro.props;
const attrs: Record<string, unknown> = {
  ...rest,
};

if (!Astro.slots.has('default')) {
  throw new Error('FormFilter: slotの中身が空です。');
}
---

<dl
  class:list={[
    'FormFilter',
    className,
  ]}
  {...attrs}
>
  {/* @slot このslotの直下では、`dt` 要素または `dd` 要素の使用のみを許容します。 */}
  <slot />
</dl>

<style>
  .FormFilter {
    --local-outline: var(--user-color-outline-dark);
    display: grid;
    grid-template-columns: minmax(0, 1fr);

    border-top: 1px solid var(--local-outline);

    > :global(dt),
    > :global(dd) {
      padding: calc(var(--user-spacing) * 4) 0;
    }

    > :global(dt) {
      font-weight: var(--user-font-weight-bold);
    }

    > :global(dd) {
      padding-top: 0;
      border-bottom: 1px solid var(--local-outline);
    }
  }

  @media (width >= 768px) {
    .FormFilter {
      grid-template-columns: minmax(0, 1fr) minmax(0, 4fr);

      > :global(dt),
      > :global(dd) {
        padding: calc(var(--user-spacing) * 6) 0;
        border-bottom: 1px solid var(--local-outline);
      }
    }
  }
</style>

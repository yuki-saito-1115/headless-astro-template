---
import type { HTMLAttributes } from 'astro/types';

/**
 * - __このコンポーネントはMarkdown実装やリッチエディタ上では利用できません。__
 */
export interface Props extends HTMLAttributes<'input'> {
  /** フォームのチェック状態を設定します。 */
  checked?: boolean;
  /** フォームを無効化します。 */
  disabled?: boolean;
  /** フォームのIDを設定します。 */
  id: string;
  /** フォームとラベルの位置を反転します。 */
  reversed?: boolean;
  /** フォームの状態を設定します。 */
  state?: 'valid' | 'invalid';
  /** フォームのタイトルを設定します。 */
  title?: string;
}

const {
  id,
  checked = false,
  disabled = false,
  title,
  reversed = false,
  state,
  class: className,
  ...rest
} = Astro.props;
const attrs: Record<string, unknown> = {
  ...rest,
};
---

<label
  for={id}
  class:list={[
    'FormCheckbox',
    reversed && 'theme-reverse',
    state && `is-${state}`,
    className,
  ]}
>
  <input
    checked={checked}
    disabled={disabled}
    id={id}
    type="checkbox"
    class:list={[
      'FormCheckbox__item',
    ]}
    {...attrs}
  />
  {title && (
    <span
      class:list={[
        'FormCheckbox__text',
      ]}
    >
      {title}
    </span>
  )}
</label>

<style>
  .FormCheckbox {
    --local-foreground: var(--user-color-primary);
    --local-background: var(--color-white);
    --local-outline: var(--user-color-outline-dark);
    --local-iconSize: 1em;
    position: relative;

    display: inline-flex;

    &::before,
    &::after {
      position: absolute;
      top: 0.25em;
      left: 0;
      display: block;
      width: var(--local-iconSize);
      height: var(--local-iconSize);
      content: '';
      border: 1px solid transparent;
    }

    /* outside */
    &::before {
      background-color: var(--local-background);
      border-color: var(--local-outline);
    }

    /* inside */
    &::after {
      background-color: var(--local-foreground);
      opacity: 0;
      mask-image: url('/assets/images/icons/check.svg');
      mask-repeat: no-repeat;
      mask-size: cover;
      transform: scale(0.6);
    }

    :where(.FormCheckbox__text) {
      position: relative;
      padding-left: calc(var(--local-iconSize) + var(--user-spacing) * 2);
      color: currentColor;
    }

    &.theme-reverse {
      &::before,
      &::after {
        right: 0;
        left: auto;
      }

      :where(.FormCheckbox__text) {
        padding-right: calc(var(--local-iconSize) + var(--user-spacing) * 2);
        padding-left: 0;
      }
    }

    &.is-invalid {
      --local-foreground: var(--user-color-danger-dark);
      --local-background: var(--user-color-danger-light);
      --local-outline: var(--user-color-danger-dark);

      color: var(--local-foreground);
    }

    &.is-valid {
      --local-foreground: var(--user-color-success-dark);
      --local-background: var(--user-color-success-light);
      --local-outline: var(--user-color-success-dark);

      color: var(--local-foreground);
    }

    &:has(:disabled) {
      --local-foreground: var(--user-color-disabled-dark);
      --local-background: var(--user-color-disabled-light);
      --local-outline: var(--user-color-disabled-light);
      color: var(--local-foreground);

      cursor: not-allowed;
    }

    &:has(:checked) {
      &::after {
        opacity: 1;
      }
    }

    &:has(:focus-visible) {
      &::before {
        outline: medium solid currentColor;
        border: 0;
      }
    }

    :where(.FormCheckbox__item) {
      position: absolute;
      top: 10px;
      left: 10px;
      width: 1px;
      height: 1px;
      appearance: none;
      opacity: 0;
    }
  }
</style>

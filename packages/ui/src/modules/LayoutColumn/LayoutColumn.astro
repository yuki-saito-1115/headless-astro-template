---
import type { HTMLAttributes } from 'astro/types';

/**
 * - __このコンポーネントはMarkdown実装やリッチエディタ上では利用できません。__
 */
export interface Props extends HTMLAttributes<'div'> {
  /** PCサイズでの列数を指定します。 */
  columnPc?: '1' | '2' | '3' | '4' | 'auto';
  /** SPサイズでの列数を指定します。 */
  columnSp?: '1' | '2' | '3' | '4' | 'auto';
}

const { columnPc = '1', columnSp = '1', class: className, ...rest } = Astro.props;
const attrs: Record<string, unknown> = {
  ...rest,
};

if (!Astro.slots.has('default')) {
  throw new Error('LayoutColumn: slotの中身が空です。');
}
---

<div
  class:list={[
    'LayoutColumn',
  ]}
  {...attrs}
>
  <div
    class:list={[
      'LayoutColumn__inner',
      columnPc && `columnPc-${columnPc}`,
      columnSp && `columnSp-${columnSp}`,
      className,
    ]}
  >
    {/* @slot 直下では `div.LayoutColumn__segment` の使用のみを許容します。 */}
    <slot />
  </div>
</div>

<style>
  .LayoutColumn {
    :where(.LayoutColumn__inner) {
      display: grid;

      > :global(:where(.LayoutColumn__segment)) {
        height: 100%;
        list-style: none;
      }
    }
  }

  @media (width < 768px) {
    .LayoutColumn {
      :where(.LayoutColumn__inner) {
        gap: calc(var(--user-spacing) * 6);

        &:where(.columnSp-2) {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        &:where(.columnSp-3) {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        &:where(.columnSp-4) {
          grid-template-columns: repeat(4, minmax(0, 1fr));
        }

        &:where(.columnSp-auto) {
          display: flex;
          flex-wrap: wrap;

          > :global(:where(.LayoutColumn__segment)) {
            flex: 0 0 auto;
            max-width: 100%;
          }
        }
      }
    }
  }

  @media (width >= 768px) {
    .LayoutColumn {
      :where(.LayoutColumn__inner) {
        gap: calc(var(--user-spacing) * 8);

        &:where(.columnPc-2) {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        &:where(.columnPc-3) {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        &:where(.columnPc-4) {
          grid-template-columns: repeat(4, minmax(0, 1fr));
        }

        &:where(.columnPc-auto) {
          display: flex;
          flex-wrap: wrap;

          > :global(:where(.LayoutColumn__segment)) {
            flex: 0 0 auto;
            max-width: 100%;
          }
        }
      }
    }
  }
</style>

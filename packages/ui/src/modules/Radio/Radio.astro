---
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'input'> {
  label?: string;
  reversed?: boolean;
  state?: 'valid' | 'invalid' | 'disabled';
}

const {
  label,
  reversed = false,
  state,
  class: className,
  ...rest
} = Astro.props;
const classList = ['Radio'];
let mergedClass = '';

if (reversed) {
  classList.push('theme-reverse');
}

if (state) {
  classList.push(`is-${state}`);
}

mergedClass = classList.join(' ');
---

<label
  for={rest.id}
  class:list={[mergedClass, className]}
>
  <input
    id={rest.id}
    class:list={['Radio__item']}
    type="radio"
    disabled={state === 'disabled'}
    {...rest}
  />
  {label && <span class:list={['Radio__text']}>{label}</span>}
</label>


<style>
  .Radio {
    --local-foreground: var(--user-color-primary);
    --local-background: var(--color-white);
    --local-outline: var(--user-color-outline-dark);
    --local-iconSize: 1em;

    display: inline-flex;
    position: relative;

    &::before,
    &::after {
      border: 1px solid transparent;
      content: '';
      display: block;
      height: var(--local-iconSize);
      left: 0;
      position: absolute;
      top: 0.25em;
      width: var(--local-iconSize);
      border-radius: 50%;
    }

    /* outside */
    &::before {
      background-color: var(--local-background);
      border-color: var(--local-outline);
    }

    /* inside */
    &::after {
      background-color: var(--local-foreground);
      opacity: 0;
      transform: scale(0.6);
    }

    &.theme-reverse {
      &::before,
      &::after {
        left: auto;
        right: 0;
      }

      :where(.Radio__text) {
        padding-left: 0;
        padding-right: calc(var(--local-iconSize) + var(--user-spacing) * 2);
      }
    }

    &.is-invalid {
      --local-foreground: var(--user-color-danger-dark);
      --local-background: var(--user-color-danger-light);
      --local-outline: var(--user-color-danger-dark);

      color: var(--local-foreground);
    }

    &.is-valid {
      --local-foreground: var(--user-color-success-dark);
      --local-background: var(--user-color-success-light);
      --local-outline: var(--user-color-success-dark);

      color: var(--local-foreground);
    }

    &:has(:disabled) {
      --local-foreground: var(--user-color-disabled-dark);
      --local-background: var(--user-color-disabled-light);
      --local-outline: var(--user-color-disabled-light);

      cursor: not-allowed;
      color: var(--local-foreground);
    }

    &:has(:checked) {
      &::after {
        opacity: 1;
      }
    }

    &:has(:focus-visible) {
      &::before {
        border: 0;
        outline: medium solid currentColor;
      }
    }

    :where(.Radio__item) {
      appearance: none;
      height: 1px;
      left: 10px;
      opacity: 0;
      position: absolute;
      top: 10px;
      width: 1px;
    }

    :where(.Radio__text) {
      color: currentColor;
      padding-left: calc(var(--local-iconSize) + var(--user-spacing) * 2);
      position: relative;
    }
  }
</style>

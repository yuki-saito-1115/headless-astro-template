---
import type { HTMLAttributes } from 'astro/types';

/**
 * - __このコンポーネントはMarkdown実装やリッチエディタ上では利用できません。__
 */
export interface Props extends HTMLAttributes<'div'> {
  /** タブに表示するテキストと、対応するパネルのslot名を設定します。 */
  datas: {
    /** タブに表示するテキストを設定します。 */
    title: string;
    /** 対応するパネルのslot名を設定します。 */
    slot: string;
  }[];
  /** タブとパネルのIDに使用する識別子を設定します。 */
  id: string;
}

const { id, datas, class: className, ...rest } = Astro.props;
const attrs: Record<string, unknown> = {
  ...rest,
};

if (datas.length === 0) {
  throw new Error('WidgetTab: datasが空です。');
}

for (const data of datas) {
  if (!Astro.slots.has(data.slot)) {
    throw new Error(`WidgetTab: ${data.slot} slotの中身が空です。`);
  }
}
---

<div
  id={id}
  class:list={[
    'WidgetTab',
    className,
  ]}
  {...attrs}
>
  <div class="WidgetTab__control">
    <div
      class="WidgetTab__list"
      role="tablist"
    >
      {datas.map((data, index) => (
        <a
          aria-controls={`${id}-${data.slot}`}
          aria-selected={index === 0 ? 'true' : 'false'}
          href={`#${id}-${data.slot}`}
          id={`${id}-tab-${index}`}
          role="tab"
        >
          {data.title}
        </a>
      ))}
    </div>
  </div>

  <div class="WidgetTab__container">
    {datas.map((data, index) => (
      <div
        aria-labelledby={`${id}-tab-${index}`}
        id={`${id}-${data.slot}`}
        role="tabpanel"
        tabindex="0"
      >
        {/* @slot このslotの中では、あらゆるコンポーネント・HTML要素・テキストノードの使用を許容します。 */}
        <slot name={data.slot} />
      </div>
    ))}
  </div>
</div>

<style>
  .WidgetTab {
    --local-foreground: var(--user-color-foreground-dark);
    --local-background: var(--user-color-background-light);
    --local-outline: var(--user-color-outline-dark);

    :where(.WidgetTab__list) {
      :where(a) {
        line-height: var(--user-line-height);
        vertical-align: top;
        text-align: center;
        text-decoration: none;

        &[aria-selected='true'] {
          --local-background: var(--user-color-secondary2);
          --local-foreground: var(--user-color-foreground-light);
          --local-outline: var(--user-color-secondary2);
        }
      }
    }

    .WidgetTab__container {
      margin-top: calc(var(--user-spacing) * 6);
    }
  }

  @media (width < 768px) {
    .WidgetTab {
      :where(.WidgetTab__list) {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: calc(var(--user-spacing) * 4);

        :where(a) {
          display: flex;
          align-items: center;
          justify-content: center;
          padding: calc(var(--user-spacing) * 4) calc(var(--user-spacing) * 6);
          color: var(--local-foreground);
          background-color: var(--local-background);
          border: 1px solid var(--local-outline);
        }
      }
    }
  }

  @media (width >= 768px) {
    .WidgetTab {
      .WidgetTab__control {
        border-bottom: 1px solid var(--local-outline);
      }

      :where(.WidgetTab__list) {
        display: flex;
        gap: calc(var(--user-spacing) * 4);

        :where(a) {
          display: block;
          padding: calc(var(--user-spacing) * 4) calc(var(--user-spacing) * 8);
          color: var(--local-foreground);
          background-color: var(--local-background);
          border-top: 1px solid var(--local-outline);
          border-right: 1px solid var(--local-outline);
          border-left: 1px solid var(--local-outline);
        }
      }
    }
  }

  @media (scripting: none) {
    .WidgetTab {
      .WidgetTab__control {
        display: none;
      }
    }
  }
</style>

<script is:inline>
  (() => {
    /**
     * 1つのタブUIを初期化する。JavaScript無効時はパネルをすべて表示し、
     * 有効時だけARIAタブとして選択中のパネル以外を非表示にする。
     */
    const setTab = (root) => {
      const links = root.querySelectorAll('[role="tab"]');
      const contents = root.querySelectorAll('[role="tabpanel"]');
      let recentNumber = 0;

      if (links.length === 0 || links.length !== contents.length) {
        return;
      }

      /** すべてのパネルをキーボード操作の対象外にして非表示にする。 */
      const hidePanel = () => {
        links.forEach((link, index) => {
          link.setAttribute('aria-selected', 'false');
          contents[index].setAttribute('hidden', 'hidden');
          contents[index].inert = true;
        });
      };

      /** 指定したパネルだけを表示して操作可能にする。 */
      const showPanel = (current) => {
        hidePanel();

        links[current].setAttribute('aria-selected', 'true');
        contents[current].removeAttribute('hidden');
        contents[current].inert = false;
      };

      /** URLハッシュが指すタブ、パネル、またはパネル内の要素を初期表示する。 */
      const setInitialPanel = () => {
        const hash = window.location.hash.slice(1);
        const target = document.getElementById(hash);
        const hashIndex = Array.from(contents).findIndex(
          (content, index) =>
            content.id === hash || links[index].id === hash || content.contains(target),
        );

        if (hashIndex >= 0) {
          recentNumber = hashIndex;
        }
      };

      /** URLハッシュを反映した初期表示状態を設定する。 */
      const build = () => {
        setInitialPanel();
        showPanel(recentNumber);
      };

      /** タブを選択したときにパネルを切り替え、パネルへフォーカスを移す。 */
      const bindEvent = () => {
        links.forEach((link, index) => {
          // クリック時だけ対応するパネルへフォーカスを移す。
          link.addEventListener('click', (event) => {
            event.preventDefault();
            event.stopPropagation();

            if (index !== recentNumber) {
              recentNumber = index;
              showPanel(index);
            }

            contents[index].focus();
          });
        });
      };

      build();
      bindEvent();
    };

    const elements = document.querySelectorAll('.WidgetTab');

    elements.forEach((element) => {
      if (element.dataset.initialized) {
        return;
      }

      setTab(element);
      element.dataset.initialized = 'true';
    });
  })();
</script>

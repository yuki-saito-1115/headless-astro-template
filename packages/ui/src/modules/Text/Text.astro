---
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'p'> {}

const { class: className, ...rest } = Astro.props;
const classList = ['Text'];
const slotHtml = await Astro.slots.render('default');
---

<p
  class:list={[classList, className]}
  {...rest}
>
  {slotHtml && <Fragment set:html={slotHtml} />}
</p>


<style>
  .Text {
    :where(strong) {
      font-weight: var(--user-font-weight-bold);
    }

    :where(em) {
      font-style: italic;
    }

    :where(u) {
      text-decoration: underline;
    }

    :where(s) {
      text-decoration: line-through;
    }

    :where(code) {
      font-family: var(--font-mono);
      font-size: smaller;
      padding: 0.125em 0.5em;
      border-radius: var(--user-border-radius);
      margin: 0 0.5em;
      border: 1px solid var(--color-gray-300);
      background-color: var(--color-gray-200);
      vertical-align: baseline;
      text-box-edge: cap alphabetic;
      line-height: 1;
    }
  }
</style>

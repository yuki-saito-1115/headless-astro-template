---
import type { Props as BadgeProps } from '@packages/ui/modules/Badge/Badge.astro';
import Badge from '@packages/ui/modules/Badge/Badge.astro';
import type { HTMLAttributes } from 'astro/types';

type BadgeListItemsProps = BadgeProps<'a'> | BadgeProps<'button'>;

/**
 * - __このコンポーネントはMarkdown実装やリッチエディタ上では利用できません。__
 */
export interface Props extends HTMLAttributes<'ul'> {
  /** 各要素は `Badge` コンポーネントが受け取るPropsと同じ形式で指定してください。 */
  datas: BadgeListItemsProps[];
}

const { datas, class: className, ...rest } = Astro.props;
const attrs: Record<string, unknown> = { ...rest };
---

<div
  class:list={[
    'BadgeList',
    className,
  ]}
  {...attrs}
>
  <ul>
    {datas.map((data: BadgeListItemsProps) => (
      <li>
        <Badge {...data} />
      </li>
    ))}
  </ul>
</div>


<style>
  .BadgeList {
    :where(ul) {
      display: flex;
      flex-wrap: wrap;
      gap: calc(var(--user-spacing) * 2);
    }

    :where(li) {
      list-style: none;
      flex: 0 0 auto;
      max-width: 100%;
    }
  }

  @media (width >= 768px) {
    .BadgeList {
      :where(ul) {
        gap: calc(var(--user-spacing) * 4);
      }
    }
  }
</style>

---
import type { HTMLAttributes } from 'astro/types';

/**
 * - __このコンポーネントはMarkdown実装やリッチエディタ上では利用できません。__
 */
export interface Props extends HTMLAttributes<'div'> {
  /** リッチエディタで登録したHTMLを設定します。 */
  datas: string;
}

const { datas, class: className, ...rest } = Astro.props;
const attrs: Record<string, unknown> = {
  ...rest,
};
---

<div
  class:list={[
    'WidgetRichEditorViewer',
    className,
  ]}
  {...attrs}
  set:html={datas}
/>

<style>
  .WidgetRichEditorViewer {
    /* .HeadingLevel2 */
    :where(h2) {
      position: relative;
      padding-bottom: calc(var(--user-spacing) * 6);
      margin-top: calc(var(--user-spacing) * 10);
      font-size: var(--text-2xl);
      font-weight: var(--user-font-weight-bold);
      line-height: var(--text-2xl--line-height);
      color: var(--user-color-foreground-dark);
      text-align: center;

      /* marker */
      &::before {
        position: absolute;
        bottom: 0;
        left: 50%;
        display: block;
        width: 64px;
        height: 5px;
        content: '';
        background-color: var(--user-color-primary);
        transform: translateX(-50%);
      }

      :where(a) {
        color: var(--user-color-primary);
        text-decoration: none;
      }
    }

    /* .HeadingLevel3 */
    :where(h3) {
      position: relative;
      padding-bottom: calc(var(--user-spacing) * 4);
      margin-top: calc(var(--user-spacing) * 10);
      font-size: var(--text-xl);
      font-weight: var(--user-font-weight-bold);
      line-height: var(--text-xl--line-height);
      color: var(--user-color-foreground-dark);

      /* border */
      &::before {
        position: absolute;
        bottom: 0;
        left: 0;
        display: block;
        width: 100%;
        height: 1px;
        content: '';
        background-color: var(--user-color-primary);
      }

      :where(a) {
        color: var(--user-color-primary);
        text-decoration: none;
      }
    }

    /* .HeadingLevel4 */
    :where(h4) {
      position: relative;
      padding-left: calc(var(--user-spacing) * 6);
      margin-top: calc(var(--user-spacing) * 10);
      font-size: var(--text-lg);
      font-weight: var(--user-font-weight-bold);
      line-height: var(--text-lg--line-height);
      color: var(--user-color-foreground-dark);

      /* marker */
      &::before {
        position: absolute;
        top: 0;
        left: 0;
        display: block;
        width: 5px;
        height: 100%;
        content: '';
        background-color: var(--user-color-primary);
      }

      :where(a) {
        color: var(--user-color-primary);
        text-decoration: none;
      }
    }

    /* .HeadingLevel5 */
    :where(h5) {
      position: relative;
      padding-left: calc(var(--user-spacing) * 6);
      margin-top: calc(var(--user-spacing) * 10);
      font-size: var(--text-base);
      font-weight: var(--user-font-weight-bold);
      line-height: var(--text-base--line-height);
      color: var(--user-color-foreground-dark);

      /* marker */
      &::before {
        position: absolute;
        top: 0.4em;
        left: 0;
        display: block;
        width: 1em;
        height: 1em;
        content: '';
        background-color: var(--user-color-primary);
      }

      :where(a) {
        color: var(--user-color-primary);
        text-decoration: none;
      }
    }

    /* .HeadingLevel6 */
    :where(h6) {
      margin-top: calc(var(--user-spacing) * 10);
      font-size: var(--text-sm);
      font-weight: var(--user-font-weight-bold);
      line-height: var(--text-sm--line-height);
      color: var(--user-color-foreground-dark);

      :where(a) {
        color: var(--user-color-primary);
        text-decoration: none;
      }
    }

    /* .Text */
    :where(p) {
      margin-top: calc(var(--user-spacing) * 10);
    }

    :where(strong) {
      font-weight: var(--user-font-weight-bold);
    }

    :where(em) {
      font-style: italic;
    }

    :where(u) {
      text-decoration: underline;
    }

    :where(s) {
      text-decoration: line-through;
    }

    :where(code) {
      padding: 0.125em 0.5em;
      margin: 0 0.5em;
      font-family: var(--font-mono);
      font-size: smaller;
      line-height: 1;
      vertical-align: baseline;
      text-box-edge: cap alphabetic;
      background-color: var(--color-gray-200);
      border: 1px solid var(--color-gray-300);
      border-radius: var(--user-border-radius);
    }

    /* .Horizon */
    :where(hr) {
      margin-top: calc(var(--user-spacing) * 10);
      border-top: 1px solid var(--user-color-outline-dark);
      border-bottom: 0;
    }

    /* TODO: 「コードブロック」用コンポーネント未設計 */

    /* .Table */
    :where(table) {
      width: 100%;
      margin-top: calc(var(--user-spacing) * 10);
      table-layout: fixed;
      border-collapse: collapse;
      background-color: var(--user-color-background-light);
      border-top: 1px solid var(--user-color-foreground-dark);
      border-left: 1px solid var(--user-color-foreground-dark);
    }

    :where(th, td) {
      padding: calc(var(--user-spacing) * 4);
      border-right: 1px solid var(--user-color-foreground-dark);
      border-bottom: 1px solid var(--user-color-foreground-dark);
    }

    :where(th) {
      font-weight: var(--user-font-weight-bold);
      text-align: center;
      background-color: var(--color-gray-200);
    }

    /* .List */
    :where(ol, ul) {
      display: grid;
      gap: var(--local-item-gap-y) var(--local-item-gap-x);
      padding-left: 1.7em;
      margin-top: calc(var(--user-spacing) * 10);

      :where(ol, ul) {
        margin-top: var(--local-item-gap-y);
      }

      :where(li) {
        position: relative;
        height: 100%;
      }
    }

    :where(ul) {
      > :global(:where(li)) {
        list-style: none;

        &::before {
          position: absolute;
          top: 0.7em;
          left: -1.7em;
          display: block;
          width: 6px;
          height: 6px;
          content: '';
          background-color: var(--user-color-primary);
          border-radius: 50%;
        }
      }
    }

    :where(ol) {
      > :global(:where(li)) {
        list-style: list-number-default;
      }
    }

    /* .Link */
    :where(a) {
      color: var(--user-color-primary);
      text-decoration: none;
      fill: var(--user-color-primary);
    }

    /* .Media */
    :where(figure) {
      display: flex;
      flex-direction: column;
      gap: calc(var(--user-spacing) * 2);
      align-items: center;
      width: fit-content;
      max-width: 100%;
      margin-inline: auto;
      margin-top: calc(var(--user-spacing) * 10);

      &[style*='text-align: left'] {
        margin-left: 0;
        text-align: revert !important;
      }

      &[style*='text-align: right'] {
        margin-right: 0;
        text-align: revert !important;
      }

      :where(a) {
        display: flex;
        flex-direction: column;
        gap: calc(var(--user-spacing) * 2);
        align-items: center;
        color: var(--user-color-primary);
        text-decoration: none;
        fill: var(--user-color-primary);
      }

      :where(img) {
        display: block;
        max-width: 100%;
        height: auto;
      }

      :where(figcaption) {
        width: 0;
        min-width: 100%;
        font-size: var(--user-font-size-note);
        text-align: center;
      }
    }

    /* .MediaEmbed */
    :where(div:has(iframe)) {
      left: revert !important;
      width: 100% !important;
      height: 100% !important;
      aspect-ratio: 16 / 9;
      padding: revert !important;
      margin-top: calc(var(--user-spacing) * 10);

      :where(iframe) {
        display: block;
        width: 100%;
        height: 100%;
      }
    }
  }
</style>

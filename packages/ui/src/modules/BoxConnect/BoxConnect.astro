---
import type { HTMLAttributes } from 'astro/types';

/**
 * - __このコンポーネントはMarkdown実装やリッチエディタ上では利用できません。__
 */
export interface Props extends HTMLAttributes<'div'> {}

const { class: className, ...rest } = Astro.props;
const attrs: Record<string, unknown> = { ...rest };

if (!Astro.slots.has('default')) {
  throw new Error('BoxConnect: slotの中身が空です。');
}
---

<div
  class:list={[
    'BoxConnect',
    className,
  ]}
  {...attrs}
>
  <slot />
</div>


<style>
  .BoxConnect {
    --local-arrow-width: 24px;
    --local-arrow-height: 16px;
    --local-gutter: calc(var(--user-spacing) * 10);

    :where(.BoxConnect__segment + .BoxConnect__segment) {
      position: relative;
      margin-top: calc(var(--local-arrow-height) + (var(--local-gutter) * 2)); /* アローの高さと上下余白 */

      /* arrow */
      &::before {
        border-bottom: 0;
        border-left: var(--local-arrow-width) solid transparent;
        border-right: var(--local-arrow-width) solid transparent;
        border-top: var(--local-arrow-height) solid var(--color-gray-200);
        bottom: calc(100% + var(--local-gutter)); /* ボックスの高さ + モジュールの余白 */
        content: '';
        display: block;
        left: 50%;
        position: absolute;
        transform: translateX(-50%);
      }
    }
  }

  @media (width >= 768px) {
    .BoxConnect {
      --local-arrow-width: 32px;
      --local-arrow-height: 24px;
      --local-gutter: calc(var(--user-spacing) * 16);
    }
  }
</style>

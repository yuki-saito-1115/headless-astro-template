---
import type { HTMLAttributes } from 'astro/types';

export interface BoxProps extends HTMLAttributes<'div'> {}

const { class: className, ...rest } = Astro.props;
const classList = ['BoxConnect'];
---

<div
  class:list={[classList, className]}
  {...rest}
>
  <slot />
</div>


<style>
  .BoxConnect {
    --local-arrow-width: 24px;
    --local-arrow-height: 16px;
    --local-gutter: var(--user-spacing) * 8;

    :where(.BoxConnect__segment) {
      > :is(:first-child) {
        margin-top: 0;
      }

      > :is(:last-child) {
        margin-bottom: 0;
      }
    }

    :where(.BoxConnect__segment + .BoxConnect__segment) {
      position: relative;
      margin-top: calc(var(--local-arrow-height) + (var(--local-gutter) * 2)); /* アローの高さと上下余白 */

      /* arrow */
      &::before {
        border-bottom: 0;
        border-left: var(--local-arrow-width) solid transparent;
        border-right: var(--local-arrow-width) solid transparent;
        border-top: var(--local-arrow-height) solid #e8e8eb;
        bottom: calc(100% + var(--local-gutter)); /* ボックスの高さ + モジュールの余白 */
        content: '';
        display: block;
        left: 50%;
        position: absolute;
        transform: translateX(-50%);
      }
    }
  }

  @media (width >= 768px) {
    .BoxConnect {
      --local-arrow-width: 32px;
      --local-arrow-height: 24px;
      --local-gutter: var(--user-spacing) * 10;
    }
  }
</style>

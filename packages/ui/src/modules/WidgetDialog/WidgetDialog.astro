---
import Button from '@packages/ui/modules/Button/Button.astro';
import type { HTMLAttributes } from 'astro/types';

/**
 * - __このコンポーネントはMarkdown実装やリッチエディタ上では利用できません。__
 * - 開くボタンには `commandfor` にこのコンポーネントの `id` を、`command` に `"show-modal"` を指定してください。
 */
export interface Props extends HTMLAttributes<'dialog'> {
  /** Invoker Commands APIで参照するダイアログのIDを設定します。 */
  id: string;
  /** ダイアログの見出しを設定します。 */
  heading: string;
  /** 閉じるボタンのテキストを設定します。 */
  closeLabel?: string;
}

const {
  id,
  heading,
  closeLabel = '閉じる',
  class: className,
  ...rest
} = Astro.props;
const attrs: Record<string, unknown> = { ...rest };

if (!Astro.slots.has('default')) {
  throw new Error('WidgetDialog: slotの中身が空です。');
}
---

<dialog
  id={id}
  class:list={[
    'WidgetDialog',
    className,
  ]}
  {...attrs}
>
  <div class="WidgetDialog__outer">
    <div class="WidgetDialog__inner">
      <header class="WidgetDialog__head">
        <button
          command="close"
          commandfor={id}
          type="button"
        >
          {closeLabel}
        </button>

        <h2>{heading}</h2>
      </header>

      <div class="WidgetDialog__body" tabindex="0">
        <slot />
      </div>

      <footer class="WidgetDialog__foot">
        <Button
          as="button"
          command="close"
          commandfor={id}
          iconBefore={{ name: 'xmark' }}
          theme="text"
          title={closeLabel}
        />
      </footer>
    </div>
  </div>
</dialog>


<style>
  .WidgetDialog {
    background-color: transparent;
    border: 0;
    height: 100%;
    max-height: 100%;
    max-width: 100%;
    overscroll-behavior: none;
    padding: 0;
    scrollbar-width: none;
    width: 100%;

    &::backdrop {
      background-color: color-mix(in srgb, var(--user-color-background-dark), transparent 40%);
    }

    .WidgetDialog__outer {
      align-items: center;
      display: flex;
      height: calc(100% + 1px);
      justify-content: center;
      padding: clamp(
        calc(var(--user-spacing) * 6),
        -13.611rem + 31.48vw,
        calc(var(--user-spacing) * 40)
      );
    }

    .WidgetDialog__inner {
      background-color: var(--user-color-background-light);
      display: flex;
      flex-direction: column;
      max-height: 100%;
      max-width: var(--user-minor-breakpoint);
      width: 100%;
    }

    .WidgetDialog__head {
      padding:
        clamp(
          calc(var(--user-spacing) * 6),
          0.611rem + 1.85vw,
          calc(var(--user-spacing) * 8)
        )
        clamp(
          calc(var(--user-spacing) * 6),
          -2.944rem + 9.26vw,
          calc(var(--user-spacing) * 16)
        );
      position: relative;

      :where(button) {
        background-color: transparent;
        border: 0;
        display: block;
        height: clamp(
          calc(var(--user-spacing) * 8),
          1.111rem + 1.85vw,
          calc(var(--user-spacing) * 10)
        );
        overflow: hidden;
        padding:
          clamp(
            calc(var(--user-spacing) * 8),
            1.111rem + 1.85vw,
            calc(var(--user-spacing) * 10)
          )
          0
          0
          clamp(
            calc(var(--user-spacing) * 8),
            1.111rem + 1.85vw,
            calc(var(--user-spacing) * 10)
          );
        position: absolute;
        right: clamp(
          calc(var(--user-spacing) * 2),
          -0.389rem + 1.85vw,
          calc(var(--user-spacing) * 4)
        );
        top: clamp(
          calc(var(--user-spacing) * 2),
          -0.389rem + 1.85vw,
          calc(var(--user-spacing) * 4)
        );
        width: clamp(
          calc(var(--user-spacing) * 8),
          1.111rem + 1.85vw,
          calc(var(--user-spacing) * 10)
        );

        &::before {
          background-color: currentColor;
          content: '';
          height: 100%;
          left: 0;
          mask-image: url('/assets/images/icons/xmark.svg');
          mask-position: center;
          mask-repeat: no-repeat;
          mask-size: 40%;
          position: absolute;
          top: 0;
          width: 100%;
        }
      }
    }

    :where(h2) {
      font-size: var(--text-2xl);
      line-height: var(--user-line-height);
      margin: 0;
      padding-right: calc(var(--user-spacing) * 10);
    }

    .WidgetDialog__body {
      margin: 0 clamp(
        calc(var(--user-spacing) * 6),
        -2.944rem + 9.26vw,
        calc(var(--user-spacing) * 16)
      );
      overflow: auto;
    }

    .WidgetDialog__foot {
      display: flex;
      justify-content: center;
      padding:
        clamp(
          calc(var(--user-spacing) * 10),
          0.722rem + 3.7vw,
          calc(var(--user-spacing) * 14)
        )
        clamp(
          calc(var(--user-spacing) * 6),
          -2.944rem + 9.26vw,
          calc(var(--user-spacing) * 16)
        );
    }
  }

  @media (width >= 768px) {
    .WidgetDialog {
      :where(h2) {
        font-size: calc(var(--user-font-size-base) * 2);
      }
    }
  }

  @media (any-hover: hover) {
    .WidgetDialog__head {
      :where(button) {
        &:hover {
          background-color: var(--user-color-primary);
          color: var(--user-color-foreground-light);

          &::before {
            background-color: currentColor;
          }
        }
      }
    }
  }

</style>

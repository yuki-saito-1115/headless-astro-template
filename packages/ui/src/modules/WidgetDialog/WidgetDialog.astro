---
import type { HTMLAttributes } from 'astro/types';

import Button from '@packages/ui/modules/Button/Button.astro';

/**
 * - __このコンポーネントはMarkdown実装やリッチエディタ上では利用できません。__
 * - 開くボタンには `commandfor` にこのコンポーネントの `id` を、`command` に `"show-modal"` を指定してください。
 */
export interface Props extends HTMLAttributes<'dialog'> {
  /** 閉じるボタンのテキストを設定します。 */
  closeLabel?: string;
  /** ダイアログの見出しを設定します。 */
  heading: string;
  /** Invoker Commands APIで参照するダイアログのIDを設定します。 */
  id: string;
}

const { id, heading, closeLabel = '閉じる', class: className, ...rest } = Astro.props;
const attrs: Record<string, unknown> = {
  ...rest,
};

if (!Astro.slots.has('default')) {
  throw new Error('WidgetDialog: slotの中身が空です。');
}
---

<dialog
  id={id}
  class:list={[
    'WidgetDialog',
    className,
  ]}
  {...attrs}
>
  <div class="WidgetDialog__outer">
    <div class="WidgetDialog__inner">
      <header class="WidgetDialog__head">
        <button type="button" command="close" commandfor={id}>
          {closeLabel}
        </button>

        <h2>{heading}</h2>
      </header>

      <!-- biome-ignore-start lint/a11y/noNoninteractiveTabindex: スクロール領域をキーボードで操作可能にする -->
      <div class="WidgetDialog__body" tabindex="0">
        {/* @slot このslotの中では、あらゆるコンポーネント・HTML要素・テキストノードの使用を許容します。 */}
        <slot />
      </div>
      <!-- biome-ignore-end lint/a11y/noNoninteractiveTabindex: キーボード操作用のスクロール領域ここまで -->

      <footer class="WidgetDialog__foot">
        <Button
          title={closeLabel}
          as="button"
          command="close"
          commandfor={id}
          iconBefore={{
            name: 'xmark',
          }}
          theme="text"
        />
      </footer>
    </div>
  </div>
</dialog>

<style>
  .WidgetDialog {
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    padding: 0;
    overscroll-behavior: none;
    scrollbar-width: none;
    background-color: transparent;
    border: 0;

    &::backdrop {
      background-color: color-mix(in srgb, var(--user-color-background-dark), transparent 40%);
    }

    .WidgetDialog__outer {
      display: flex;
      align-items: center;
      justify-content: center;
      height: calc(100% + 1px);
      padding: clamp(calc(var(--user-spacing) * 6), -13.611rem + 31.48vw, calc(var(--user-spacing) * 40));
    }

    .WidgetDialog__inner {
      display: flex;
      flex-direction: column;
      width: 100%;
      max-width: var(--user-minor-breakpoint);
      max-height: 100%;
      background-color: var(--user-color-background-light);
    }

    .WidgetDialog__head {
      position: relative;
      padding: clamp(calc(var(--user-spacing) * 6), 0.611rem + 1.85vw, calc(var(--user-spacing) * 8)) clamp(calc(var(--user-spacing) * 6), -2.944rem + 9.26vw, calc(var(--user-spacing) * 16));

      :where(button) {
        position: absolute;
        top: clamp(calc(var(--user-spacing) * 2), -0.389rem + 1.85vw, calc(var(--user-spacing) * 4));
        right: clamp(calc(var(--user-spacing) * 2), -0.389rem + 1.85vw, calc(var(--user-spacing) * 4));
        display: block;
        width: clamp(calc(var(--user-spacing) * 8), 1.111rem + 1.85vw, calc(var(--user-spacing) * 10));
        height: clamp(calc(var(--user-spacing) * 8), 1.111rem + 1.85vw, calc(var(--user-spacing) * 10));
        padding: clamp(calc(var(--user-spacing) * 8), 1.111rem + 1.85vw, calc(var(--user-spacing) * 10)) 0 0 clamp(calc(var(--user-spacing) * 8), 1.111rem + 1.85vw, calc(var(--user-spacing) * 10));
        overflow: hidden;
        background-color: transparent;
        border: 0;

        &::before {
          position: absolute;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
          content: '';
          background-color: currentColor;
          mask-image: url('/assets/images/icons/xmark.svg');
          mask-repeat: no-repeat;
          mask-position: center;
          mask-size: 40%;
        }
      }
    }

    :where(h2) {
      padding-right: calc(var(--user-spacing) * 10);
      margin: 0;
      font-size: var(--text-2xl);
      line-height: var(--user-line-height);
    }

    .WidgetDialog__body {
      margin: 0 clamp(calc(var(--user-spacing) * 6), -2.944rem + 9.26vw, calc(var(--user-spacing) * 16));
      overflow: auto;
    }

    .WidgetDialog__foot {
      display: flex;
      justify-content: center;
      padding: clamp(calc(var(--user-spacing) * 10), 0.722rem + 3.7vw, calc(var(--user-spacing) * 14)) clamp(calc(var(--user-spacing) * 6), -2.944rem + 9.26vw, calc(var(--user-spacing) * 16));
    }
  }

  @media (width >= 768px) {
    .WidgetDialog {
      :where(h2) {
        font-size: calc(var(--user-font-size-base) * 2);
      }
    }
  }

  @media (any-hover: hover) {
    .WidgetDialog__head {
      :where(button) {
        &:hover {
          color: var(--user-color-foreground-light);
          background-color: var(--user-color-primary);

          &::before {
            background-color: currentColor;
          }
        }
      }
    }
  }
</style>

---
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'input'> {
  size?: 'small' | 'medium' | 'large' | 'full';
  state?: 'valid' | 'invalid' | 'disabled';
}

const { size, state, class: className, ...rest } = Astro.props;
const classList = ['Textbox'];
let mergedClass = '';

if (size) {
  classList.push(`theme-${size}`);
}

if (state) {
  classList.push(`is-${state}`);
}

mergedClass = classList.join(' ');
---

<span class:list={[className, mergedClass]}>
  <input
    class:list={['Textbox__item']}
    disabled={state === 'disabled'}
    {...rest}
  />
</span>


<style>
  .Textbox {
    --local-foreground: var(--user-color-foreground-dark);
    --local-background: var(--user-color-background-light);
    --local-outline: var(--user-color-outline-dark);
    --local-placeholder: var(--color-gray-500);
    --local-width: auto;

    /* Preflight */
    :where(
      [type='text'],
      [type='email'],
      [type='password'],
      [type='search'],
      [type='number'],
      [type='tel'],
      [type='url']
    ) {
      /* デフォルトスタイルリセットするため */
      font: unset;

      /* ブラウザごとの差異を統一するため */
      color: currentColor;
      appearance: none;

      /* SPでフォーカス時にズームしないために16pxに固定 */
      font-size: var(--text-base); /* 2 */

      /* 要素の中のテキストの高さを限定するため */
      line-height: 1;
      border-radius: 0;

      /* ブラウザごとの差異を統一しデフォルトスタイルリセットするため */
      ::placeholder {
        font-style: normal;
        color: var(--color-gray-400);
        opacity: 1;
      }
    }

    border: 1px solid var(--local-outline);
    display: inline-flex;
    max-width: 100%;
    overflow: hidden;
    width: var(--local-width);

    &:focus-within {
      outline: medium solid currentColor;
    }

    :where(.Textbox__item) {
      appearance: none;
      background-color: var(--local-background);
      border: 0;
      color: var(--local-foreground);
      display: block;
      outline: none;
      padding: calc(var(--user-spacing) * 1) calc(var(--user-spacing) * 2);
      width: 100%;

      &::placeholder {
        color: var(--local-placeholder);
        opacity: 0.5;
      }
    }

    &.is-valid,
    :global(&.is-valid) {
      --local-foreground: var(--color-emerald-700);
      --local-background: var(--color-emerald-100);
      --local-outline: var(--color-emerald-700);

      ::placeholder {
        color: var(--local-foreground);
      }
    }

    &.is-invalid,
    :global(&.is-invalid) {
      --local-foreground: var(--color-rose-600);
      --local-background: var(--color-rose-100);
      --local-outline: var(--color-rose-600);

      ::placeholder {
        color: var(--local-foreground);
      }
    }

    &:has(:disabled) {
      --local-foreground: var(--color-gray-400);
      --local-background: var(--color-gray-200);
      --local-outline: var(--color-gray-200);

      ::placeholder {
        color: var(--local-foreground);
      }

      :is(.Textbox__item) {
        cursor: not-allowed;
      }
    }

    &.theme-small {
      --local-width: 25%;
    }

    &.theme-medium {
      --local-width: 50%;
    }

    &.theme-large {
      --local-width: 75%;
    }

    &.theme-full {
      --local-width: 100%;
    }
  }
</style>

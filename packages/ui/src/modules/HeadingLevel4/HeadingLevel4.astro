---
import type { HTMLAttributes } from 'astro/types';

/**
 * - __このコンポーネントはmicroCMSのリッチエディタの [見出し、段落](https://document.microcms.io/manual/rich-editor-usage#hdec08ed8b7) と関連しています。__
 */
export interface Props extends HTMLAttributes<'div'> {}

const { class: className, ...rest } = Astro.props;
const attrs: Record<string, unknown> = {
  ...rest,
};

if (!Astro.slots.has('default')) {
  throw new Error('HeadingLevel4: slotの中身が空です。');
}
---

<div
  class:list={[
    'HeadingLevel4',
    className,
  ]}
  {...attrs}
>
  {/* @slot このslotの直下では、クラス名無しの `h1` ～ `h6` までの見出し要素または `div` 要素の使用のみを許容します。 */}
  <slot />
</div>

<style>
  .HeadingLevel4 {
    :where(h1, h2, h3, h4, h5, h6) {
      position: relative;
      padding-left: calc(var(--user-spacing) * 6);
      font-size: var(--text-lg);
      font-weight: var(--user-font-weight-bold);
      line-height: var(--user-line-height);
      color: var(--user-color-foreground-dark);

      /* marker */
      &::before {
        position: absolute;
        top: 0;
        left: 0;
        display: block;
        width: 5px;
        height: 100%;
        content: '';
        background-color: var(--user-color-primary);
      }

      :where(a) {
        color: var(--user-color-primary);
        text-decoration: none;
      }
    }
  }

  @media (width >= 768px) {
    .HeadingLevel4 {
      :where(h1, h2, h3, h4, h5, h6) {
        font-size: var(--text-xl);
        line-height: var(--user-line-height);
      }
    }
  }

  @media (any-hover: hover) {
    .HeadingLevel4 {
      :where(h1, h2, h3, h4, h5, h6) {
        :where(a) {
          &:hover {
            text-decoration: underline;
          }
        }
      }
    }
  }
</style>

---
import type { HTMLAttributes } from 'astro/types';

/**
 * - __このコンポーネントはmicroCMSのリッチエディタの [見出し、段落](https://document.microcms.io/manual/rich-editor-usage#hdec08ed8b7) と関連しています。__
 */
export interface Props extends HTMLAttributes<'div'> {}

const { class: className, ...rest } = Astro.props;
const attrs: Record<string, unknown> = { ...rest };

if (!Astro.slots.has('default')) {
  throw new Error('HeadingLevel6: slotの中身が空です。');
}
---

<div
  class:list={['HeadingLevel6', className]}
  {...attrs}
>
  {/* @slot 直下では `h1` ～ `h6` までの見出し要素または `div` 要素の使用のみを許容します。 */}
  <slot />
</div>


<style>
  .HeadingLevel6 {
    :where(h1, h2, h3, h4, h5, h6) {
      font-weight: var(--user-font-weight-bold);
      color: var(--user-color-foreground-dark);
      line-height: var(--user-line-height);
      font-size: var(--text-sm);

      :where(a) {
        color: var(--user-color-primary);
        text-decoration: none;
      }
    }
  }

  @media (width >= 768px) {
    .HeadingLevel6 {
      :where(h1, h2, h3, h4, h5, h6) {
        line-height: var(--user-line-height);
        font-size: var(--text-base);
      }
    }
  }

  @media (any-hover: hover) {
    .HeadingLevel6 {
      :where(h1, h2, h3, h4, h5, h6) {
        :where(a) {
          &:hover {
            text-decoration: underline;
          }
        }
      }
    }
  }
</style>

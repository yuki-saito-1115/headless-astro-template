---
import type { HTMLAttributes } from 'astro/types';

/**
 * - __このコンポーネントはMarkdown実装やリッチエディタ上では利用できません。__
 */
export interface Props extends HTMLAttributes<'div'> {
  /** PC幅時の並び方向を設定します。 */
  directPc?: 'row' | 'column' | 'wrap';
  /** SP幅時の並び方向を設定します。 */
  directSp?: 'row' | 'column' | 'wrap';
}

const { directSp = 'row', directPc = 'row', class: className, ...rest } = Astro.props;
const attrs: Record<string, unknown> = {
  ...rest,
};

if (!Astro.slots.has('default')) {
  throw new Error('FormComplex: slotの中身が空です。');
}
---

<div
  class:list={[
    'FormComplex',
    `directSp-${directSp}`,
    `directPc-${directPc}`,
    className,
  ]}
  {...attrs}
>
  {/* @slot このslotの直下では、`span.FormComplex__segment` の使用のみを許容します。 */}
  <slot />
</div>

<style>
  .FormComplex {
    display: flex;
    gap: calc(var(--user-spacing) * 2);
    align-items: center;

    :global(.FormComplex__segment) {
      display: flex;
      gap: calc(var(--user-spacing) * 2);
      align-items: center;
    }
  }

  @media (width < 768px) {
    .FormComplex {
      &:where(.directSp-column) {
        flex-direction: column;
        align-items: flex-start;
      }

      &:where(.directSp-wrap) {
        flex-wrap: wrap;
      }
    }
  }

  @media (width >= 768px) {
    .FormComplex {
      &:where(.directPc-column) {
        flex-direction: column;
        align-items: flex-start;
      }

      &:where(.directPc-wrap) {
        flex-wrap: wrap;
      }
    }
  }
</style>

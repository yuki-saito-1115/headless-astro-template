---
import type { HTMLAttributes } from 'astro/types';

/**
 * - __このコンポーネントはMarkdown実装やリッチエディタ上では利用できません。__
 */
export interface Props extends HTMLAttributes<'div'> {
  /** SP幅時のコンテンツと画像の並び方向を設定します。 */
  directSp?: 'row' | 'column';
  /** PC幅時のコンテンツと画像の並び方向を設定します。 */
  directPc?: 'row' | 'column';
}

const {
  directSp = 'row',
  directPc = 'row',
  class: className,
  ...rest
} = Astro.props;
const attrs: Record<string, unknown> = { ...rest };

if (!Astro.slots.has('default')) {
  throw new Error('FormComplex: slotの中身が空です。');
}
---

<div
  class:list={[
    'FormComplex',
    `directSp-${directSp}`,
    `directPc-${directPc}`,
    className
  ]}
  {...attrs}
>
  <slot />
</div>


<style>
  .FormComplex {
    align-items: center;
    display: flex;
    gap: calc(var(--user-spacing) * 2);

    :global(.FormComplex__segment) {
      display: flex;
      gap: calc(var(--user-spacing) * 2);
    }
  }

  @media (width < 768px) {
    .FormComplex {
      &:where(.directSp-column) {
        align-items: flex-start;
        flex-direction: column;
      }
    }
  }

  @media (width >= 768px) {
    .FormComplex {
      &:where(.directPc-column) {
        align-items: flex-start;
        flex-direction: column;
      }
    }
  }
</style>

---
import type { HTMLAttributes } from 'astro/types';

/**
 * - __このコンポーネントはmicroCMSのリッチエディタの [区切り線](https://document.microcms.io/manual/rich-editor-usage#hbfbcb364fd) と関連しています。__
 */
export interface Props extends HTMLAttributes<'hr'> {
  /** 罫線のスタイルを設定できます。ただしこのPropsはリッチエディタでは利用できません。 */
  theme?: 'dotted' | 'dashed' | undefined;
}

const { theme = undefined, class: className, ...rest } = Astro.props;
const attrs: Record<string, unknown> = {
  ...rest,
};

if (!Astro.slots.has('default')) {
  throw new Error('Horizon: slotの中身が空です。');
}
---

<div
  class:list={[
    'Horizon',
    theme && `theme-${theme}`,
    className,
  ]}
  {...attrs}
>
  {/* @slot このslotの直下では、クラス名無しの `hr` 要素の使用のみを許容します。 */}
  <slot />
</div>

<style>
  .Horizon {
    :where(hr) {
      border-top: 1px solid var(--user-color-outline-dark);
      border-bottom: 0;
    }

    /* 注意 */
    &:where(.theme-dotted) {
      :where(hr) {
        border-top-style: dotted;
      }
    }

    /* 破線 */
    &:where(.theme-dashed) {
      :where(hr) {
        border-top-style: dashed;
      }
    }
  }
</style>

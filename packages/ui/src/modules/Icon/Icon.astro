---
import type { CommonTypeIconSprite } from '@packages/content/types/CommonType';
import type { HTMLAttributes } from 'astro/types';

export interface IconPropType extends HTMLAttributes<'svg'> {
  label?: string;
  lang?: 'ja' | 'en';
  sprite: CommonTypeIconSprite;
}

const { sprite, lang = 'ja', label, class: className, ...rest } = Astro.props;
const classList = ['Icon'];
const icon = {
  'arrow-up-right-from-square': {
    ja: '別ウィンドウで開く',
    en: 'Open in new window',
  },
  download: {
    ja: 'ファイルをダウンロードする',
    en: 'Download file',
  },
  'file-excel': {
    ja: 'Excelファイルをダウンロードする',
    en: 'Download Excel file',
  },
  'file-pdf': {
    ja: 'PDFファイルをダウンロードする',
    en: 'Download PDF file',
  },
  'file-powerpoint': {
    ja: 'PowerPointファイルをダウンロードする',
    en: 'Download PowerPoint file',
  },
  'file-word': {
    ja: 'Wordファイルをダウンロードする',
    en: 'Download Word file',
  },
  'file-zipper': {
    ja: 'Zipファイルをダウンロードする',
    en: 'Download Zip file',
  },
  'window-restore': {
    ja: 'モーダルウィンドウで開く',
    en: 'Open in new window',
  },
  xmark: {
    ja: '閉じる',
    en: 'Close',
  },
};

const role = rest.role === undefined ? 'img' : 'presentation';
let labelText: string | undefined;

if (icon[sprite as keyof typeof icon] && role !== 'presentation') {
  labelText = icon[sprite as keyof typeof icon][lang as 'ja' | 'en'];

  if (label) {
    labelText = label;
  }
}
---

<svg
  class:list={[classList, className]}
  {...rest}
  role={role}
  viewBox="0 0 100 100"
>
  {labelText && <title>{labelText}</title>}
  <use href={`#${sprite}`}></use>
</svg>


<style>
  .Icon {
    color: currentColor;
    display: inline-block;
    flex: 0 0 auto;
    height: 1em;
    vertical-align: baseline;
    width: 1em;
  }
</style>

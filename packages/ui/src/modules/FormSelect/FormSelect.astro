---
import type { HTMLAttributes } from 'astro/types';

/**
 * - __このコンポーネントはMarkdown実装やリッチエディタ上では利用できません。__
 */
export interface Props extends HTMLAttributes<'select'> {
  /** フォームを無効化します。 */
  disabled?: boolean;
  /** `option` 要素の属性を指定します。 */
  options: HTMLAttributes<'option'>[];
  /** フォームのサイズを設定します。 */
  size?: 'small' | 'medium' | 'large' | 'full';
  /** フォームの状態を設定します。 */
  state?: 'valid' | 'invalid';
}

const { disabled = false, options, size, state, class: className, ...rest } = Astro.props;
const attrs: Record<string, unknown> = {
  ...rest,
};
---

<span
  class:list={[
    'FormSelect',
    size && `theme-${size}`,
    state && `is-${state}`,
    className,
  ]}
>
  <select
    disabled={disabled}
    class:list={[
      'FormSelect__item',
    ]}
    {...attrs}
  >
    {options.map((option) => <option {...option}>{option.label}</option>)}
  </select>
</span>

<style>
  .FormSelect {
    --local-foreground: var(--user-color-foreground-dark);
    --local-background: var(--user-color-background-light);
    --local-outline: var(--user-color-outline-dark);
    --local-width: auto;
    --local-iconSize: 1em;
    --local-padding: calc(var(--user-spacing) * 3);
    position: relative;
    display: inline-flex;
    width: var(--local-width);
    max-width: 100%;
    overflow: hidden;

    border: 1px solid var(--local-outline);

    /* Preflight */
    :where(.FormSelect__item) {
      /* デフォルトスタイルリセットするため */
      font: unset;

      /* SPでフォーカス時にズームしないために16pxに固定 */
      font-size: var(--text-base); /* 2 */

      /* 要素の中のテキストの高さを限定するため */
      line-height: 1;

      /* ブラウザごとの差異を統一するため */
      color: currentColor;
      appearance: none;
      border-radius: 0;

      /* ブラウザごとの差異を統一しデフォルトスタイルリセットするため */
      ::placeholder {
        font-style: normal;
        color: var(--color-gray-400);
        opacity: 1;
      }
    }

    /* icon */
    &::before {
      position: absolute;
      top: 50%;
      right: var(--local-padding);
      width: var(--local-iconSize);
      height: var(--local-iconSize);
      pointer-events: none;
      content: '';
      background-color: currentColor;
      mask-image: url('/assets/images/icons/angle-down.svg');
      mask-repeat: no-repeat;
      mask-position: center;
      mask-size: 70%;
      transform: translateY(-50%);
    }

    &:focus-within {
      outline: medium solid currentColor;
    }

    :where(.FormSelect__item) {
      display: block;
      width: 100%;
      padding: var(--local-padding) calc(var(--local-iconSize) + (var(--local-padding) * 2))
        var(--local-padding) var(--local-padding);
      color: var(--local-foreground);
      appearance: none;
      outline: none;
      background-color: var(--local-background);
      border: 0;
    }

    &.is-valid,
    :global(&.is-valid) {
      --local-foreground: var(--user-color-success-dark);
      --local-background: var(--user-color-success-light);
      --local-outline: var(--user-color-success-dark);
    }

    &.is-invalid,
    :global(&.is-invalid) {
      --local-foreground: var(--user-color-danger-dark);
      --local-background: var(--user-color-danger-light);
      --local-outline: var(--user-color-danger-dark);

      &::before {
        color: var(--local-foreground);
      }
    }

    &:has(:disabled) {
      --local-foreground: var(--user-color-disabled-dark);
      --local-background: var(--user-color-disabled-light);
      --local-outline: var(--user-color-disabled-light);

      :is(&::before) {
        color: var(--local-foreground);
      }

      :is(.FormSelect__item) {
        cursor: not-allowed;
      }
    }

    &.theme-small {
      --local-width: 25%;
    }

    &.theme-medium {
      --local-width: 50%;
    }

    &.theme-large {
      --local-width: 75%;
    }

    &.theme-full {
      --local-width: 100%;
    }
  }
</style>

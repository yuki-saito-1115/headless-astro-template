---
import type { HTMLAttributes } from 'astro/types';

/**
 * - __このコンポーネントはmicroCMSのリッチエディタの [埋め込み編集](https://document.microcms.io/manual/rich-editor-usage#h8924563329) と関連しています。__
 */
export interface Props extends HTMLAttributes<'div'> {
  /** 埋め込みコンテンツを表示領域に入った時点で読み込みます。ただしこのPropsはリッチエディタでは利用できません。 */
  lazyLoad?: boolean;
}

const { lazyLoad = true, class: className, ...rest } = Astro.props;
const attrs: Record<string, unknown> = { ...rest };

if (!Astro.slots.has('default')) {
  throw new Error('MediaEmbed: slotの中身が空です。');
}
---
<div
  class:list={[
    'MediaEmbed',
    className,
  ]}
  {...attrs}
>
  {lazyLoad ? (
    <template>
      {/* @slot 直下ではmicroCMSのリッチエディタの [埋め込み編集](https://document.microcms.io/manual/rich-editor-usage#h8924563329) の形式のみ許容します。 */}
      <slot />
    </template>
  ) : (
    <slot />
  )}
</div>


<style>
  .MediaEmbed {
    &:has(> template) {
      aspect-ratio: 16 / 9;
    }

    :where(div:has(iframe)) {
      aspect-ratio: 16 / 9;
      height: 100% !important;
      left: revert !important;
      padding: revert !important;
      width: 100% !important;

      :where(iframe) {
        display: block;
        width: 100%;
        height: 100%;
      }
    }
  }
</style>

<script is:inline>
  (() => {
    /** 表示領域に入った埋め込みコンテンツを読み込む。 */
    const setMediaEmbed = (root) => {
      const template = root.querySelector('template');

      if (!template) {
        return;
      }

      const observer = new IntersectionObserver(([entry]) => {
        if (!entry.isIntersecting) {
          return;
        }

        root.replaceChildren(template.content);
        observer.unobserve(root);
      });

      observer.observe(root);
    };

    const elements = document.querySelectorAll('.MediaEmbed');

    elements.forEach((element) => {
      if (element.dataset.initialized) {
        return;
      }

      setMediaEmbed(element);
      element.dataset.initialized = 'true';
    });
  })();
</script>

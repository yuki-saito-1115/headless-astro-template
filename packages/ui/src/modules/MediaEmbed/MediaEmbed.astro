---
import type { HTMLAttributes } from 'astro/types';

/**
 * - __このコンポーネントはmicroCMSのリッチエディタの [埋め込み編集](https://document.microcms.io/manual/rich-editor-usage#h8924563329) と関連しています。__
 */
export interface Props extends HTMLAttributes<'div'> {
  /** 埋め込みコンテンツを表示領域に入った時点で読み込みます。 */
  facade?: boolean;
}

const { facade = true, class: className, ...rest } = Astro.props;
const attrs: Record<string, unknown> = { ...rest };

if (!Astro.slots.has('default')) {
  throw new Error('MediaEmbed: slotの中身が空です。');
}
---
<div
  class:list={[
    'MediaEmbed',
    className,
  ]}
  {...attrs}
>
  {facade ? (
    <template><slot /></template>
  ) : (
    <slot />
  )}

  <script is:inline>
    (() => {
      const setFacade = () => {
        const root = document.currentScript.parentElement;
        const template = root.querySelector('template');

        if (!template) {
          return;
        }

        const observer = new IntersectionObserver(([entry]) => {
          if (!entry.isIntersecting) {
            return;
          }

          root.replaceChildren(template.content);
          observer.unobserve(root);
        });

        observer.observe(root);
      };

      setFacade();
    })();
  </script>
</div>


<style>
  .MediaEmbed {
    aspect-ratio: 16 / 9;

    :where(div) {
      height: 100% !important;
      padding: revert !important;
    }

    :where(iframe) {
      display: block;
      width: 100%;
      height: 100%;
    }
  }
</style>

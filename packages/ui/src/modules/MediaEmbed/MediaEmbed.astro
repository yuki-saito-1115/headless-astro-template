---
import type { HTMLAttributes } from 'astro/types';

/**
 * - __このコンポーネントはmicroCMSのリッチエディタの [埋め込み編集](https://document.microcms.io/manual/rich-editor-usage#h8924563329) と関連しています。__
 */
export interface Props extends HTMLAttributes<'div'> {
  /** 埋め込みコンテンツを表示領域に入った時点で読み込みます。 */
  facade?: boolean;
}

const { facade = true, class: className, ...rest } = Astro.props;
const attrs: Record<string, unknown> = { ...rest };

if (!Astro.slots.has('default')) {
  throw new Error('MediaEmbed: slotの中身が空です。');
}
---
<div
  class:list={[
    'MediaEmbed',
    className,
  ]}
  {...attrs}
>
  {facade ? (
    <template><slot /></template>
  ) : (
    <slot />
  )}
</div>


<script define:vars={{ facade }}>
  (() => {
    const facade = () => {
      if (!facade) {
        return;
      }

      const root = document.currentScript.previousElementSibling;
      const template = root.querySelector('template');

      const observer = new IntersectionObserver(([entry]) => {
        if (!entry.isIntersecting) {
          return;
        }

        root.replaceChildren(template.content);
        observer.unobserve(root);
      });

      observer.observe(root);
    };

    facade();
  })();
</script>


<style>
  .MediaEmbed {
    aspect-ratio: 16 / 9;

    :where(div) {
      height: revert !important;
      padding: revert !important;
    }

    :where(iframe) {
      display: block;
      width: 100%;
      height: 100%;
    }
  }
</style>

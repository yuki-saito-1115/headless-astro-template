---
import type { HTMLAttributes } from 'astro/types';

/**
 * - __このコンポーネントはmicroCMSのリッチエディタの [埋め込み編集](https://document.microcms.io/manual/rich-editor-usage#h8924563329) と関連しています。__
 */
export interface Props extends HTMLAttributes<'div'> {}

const { class: className, ...rest } = Astro.props;
const attrs: Record<string, unknown> = { ...rest };

if (!Astro.slots.has('default')) {
  throw new Error('MediaEmbed: slotの中身が空です。');
}
---
<div
  class:list={['MediaEmbed', className]}
  {...attrs}
>
  <slot />
</div>


<style>
  .MediaEmbed {
    :where(div) {
      height: revert !important;
      padding: revert !important;
      aspect-ratio: 16 / 9;
    }

    :where(iframe) {
      display: block;
      width: 100%;
      height: 100%;
    }
  }
</style>

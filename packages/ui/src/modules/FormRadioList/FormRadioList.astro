---
import type { HTMLAttributes } from 'astro/types';

import type { Props as FormRadioProps } from '@packages/ui/modules/FormRadio/FormRadio.astro';
import FormRadio from '@packages/ui/modules/FormRadio/FormRadio.astro';

/**
 * - __このコンポーネントはMarkdown実装やリッチエディタ上では利用できません。__
 */
export interface Props extends HTMLAttributes<'div'> {
  /** PCサイズでの列数を指定します。 */
  columnPc?: '1' | '2' | '3' | '4' | 'auto';
  /** SPサイズでの列数を指定します。 */
  columnSp?: '1' | '2' | '3' | '4' | 'auto';
  /** 各要素は `FormRadio` コンポーネントが受け取るPropsと同じ形式で指定してください。 */
  datas: FormRadioProps[];
}

const { columnPc = '1', columnSp = '1', datas, class: className, ...rest } = Astro.props;
const attrs: Record<string, unknown> = {
  ...rest,
};
---

<div
  class:list={[
    'FormRadioList',
    `columnPc-${columnPc}`,
    `columnSp-${columnSp}`,
    className,
  ]}
  {...attrs}
>
  {datas.map((data) => (
    <div class="FormRadioList__item">
      <FormRadio {...data} />
    </div>
  ))}
</div>

<style>
  .FormRadioList {
    display: grid;
    gap: calc(var(--user-spacing) * 2) calc(var(--user-spacing) * 4);

    :where(.FormRadioList__item) {
      height: 100%;
    }
  }

  @media (width < 768px) {
    .FormRadioList {
      &:where(.columnSp-2) {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      &:where(.columnSp-3) {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      &:where(.columnSp-4) {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }

      &:where(.columnSp-auto) {
        display: flex;
        flex-wrap: wrap;

        :where(.FormRadioList__item) {
          flex: 0 0 auto;
          max-width: 100%;
        }
      }
    }
  }

  @media (width >= 768px) {
    .FormRadioList {
      &:where(.columnPc-2) {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      &:where(.columnPc-3) {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      &:where(.columnPc-4) {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }

      &:where(.columnPc-auto) {
        display: flex;
        flex-wrap: wrap;

        :where(.FormRadioList__item) {
          flex: 0 0 auto;
          max-width: 100%;
        }
      }
    }
  }
</style>

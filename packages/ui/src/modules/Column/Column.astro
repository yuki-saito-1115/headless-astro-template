---
import type { HTMLAttributes } from 'astro/types';

/**
 * - __このコンポーネントはMarkdown実装やリッチエディタ上では利用できません。__
 */
export interface Props extends HTMLAttributes<'div'> {
  /** PCサイズでの列数を指定します。 */
  columnPc?: '1' | '2' | '3' | '4' | '5' | 'auto';
  /** SPサイズでの列数を指定します。 */
  columnSp?: '1' | '2' | '3' | '4' | '5' | 'auto';
}

const {
  columnPc = '1',
  columnSp = '1',
  class: className,
  ...rest
} = Astro.props;
const attrs: Record<string, unknown> = { ...rest };

if (!Astro.slots.has('default')) {
  throw new Error('Column: slotの中身が空です。');
}
---

<div
  class:list={[
    'Column',
    className
  ]}
  {...attrs}
>
  <div
    class:list={[
      'Column__inner',
      columnPc && `columnPc-${columnPc}`,
      columnSp && `columnSp-${columnSp}`,
    ]}
  >
    <slot />
  </div>
</div>


<style>
  .Column {
    container-type: inline-size;

    :where(.Column__inner) {
      display: grid;
    }

    :where(.Column__segment) {
      list-style: none;
      height: 100%;

      > :is(:first-child) {
        margin-top: 0;
      }

      > :is(:last-child) {
        margin-bottom: 0;
      }
    }
  }

  @container (max-width: 767.99px) {
    .Column {
      :where(.Column__inner) {
        gap: calc(var(--user-spacing) * 6);

        &.columnSp-2 {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        &.columnSp-3 {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        &.columnSp-4 {
          grid-template-columns: repeat(4, minmax(0, 1fr));
        }

        &.columnSp-auto {
          display: flex;
          flex-wrap: wrap;

          :where(.Column__segment) {
            flex: 0 0 auto;
            max-width: 100%;
          }
        }
      }
    }
  }

  @container (min-width: 768px) {
    .Column {
      :where(.Column__inner) {
        gap: calc(var(--user-spacing) * 8);

        &.columnPc-2 {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        &.columnPc-3 {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        &.columnPc-4 {
          grid-template-columns: repeat(4, minmax(0, 1fr));
        }

        &.columnPc-auto {
          display: flex;
          flex-wrap: wrap;

          :where(.Column__segment) {
            flex: 0 0 auto;
            max-width: 100%;
          }
        }
      }
    }
  }
</style>

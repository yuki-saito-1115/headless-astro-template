---
import type { HTMLAttributes } from 'astro/types';

/**
 * - __このコンポーネントはMarkdown実装やリッチエディタ上では利用できません。__
 */
export interface Props extends HTMLAttributes<'div'> {}

const { class: className, ...rest } = Astro.props;
const attrs: Record<string, unknown> = {
  ...rest,
};

if (!Astro.slots.has('default')) {
  throw new Error('TextCaution: slotの中身が空です。');
}
---

<div
  class:list={[
    'TextCaution',
    className,
  ]}
  {...attrs}
>
  {/* @slot このslotの直下では、クラス名無しの `div` 要素または `p` 要素の使用のみを許容します。 */}
  <slot />
</div>

<style>
  .TextCaution {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: calc(var(--user-spacing) * 4);
    padding-left: 1.5em;
    font-weight: var(--user-font-weight-bold);
    line-height: var(--user-line-height);
    color: var(--user-color-warning-dark);

    /* icon */
    &::before {
      position: absolute;
      top: 0.3em;
      left: 0;
      display: block;
      width: 1em;
      height: 1em;
      content: '';
      background-color: currentColor;
      mask-image: url('/assets/images/icons/circle-exclamation.svg');
      mask-repeat: no-repeat;
      mask-size: cover;
    }

    :where(div, p) {
      flex: 0 0 auto;
    }
  }
</style>

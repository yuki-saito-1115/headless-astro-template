---
import type { HTMLAttributes } from 'astro/types';

/**
 * - __このコンポーネントはMarkdown実装やリッチエディタ上では利用できません。__
 */
export interface Props extends HTMLAttributes<'div'> {
  /** PCサイズでの列数を指定します。 */
  columnPc?: '1' | '2' | '3' | '4' | 'auto';
  /** SPサイズでの列数を指定します。 */
  columnSp?: '1' | '2' | '3' | '4' | 'auto';
  /** リンク要素の属性を指定します。`title` はリンクテキストとして表示され、title属性には出力されません。 */
  datas: HTMLAttributes<'a'>[];
}

const {
  columnPc = '1',
  columnSp = '1',
  datas,
  class: className,
  ...rest
} = Astro.props;
const attrs: Record<string, unknown> = { ...rest };
---

<div
  class:list={[
    'LinkList',
    columnPc && `columnPc-${columnPc}`,
    columnSp && `columnSp-${columnSp}`,
    className,
  ]}
  {...attrs}
>
  <ul>
    {datas.map(({ title, ...linkAttrs }) => (
      <li>
        <a {...linkAttrs}>{title}</a>
      </li>
    ))}
  </ul>
</div>

<style>
  .LinkList {
    --local-item-gap-x: calc(var(--user-spacing) * 6);
    --local-item-gap-y: calc(var(--user-spacing) * 2);

    container-type: inline-size;

    > :where(ul) {
      display: grid;
      gap: var(--local-item-gap-y) var(--local-item-gap-x);

      > :where(li) {
        height: 100%;
        list-style: none;
        padding-left: 1.25em;
        position: relative;

        /* arrow */
        &::before {
          background-color: var(--user-color-primary);
          content: '';
          display: block;
          height: 0.75em;
          left: 0;
          mask-image: url('/assets/images/icons/angle-right.svg');
          mask-repeat: no-repeat;
          mask-size: cover;
          position: absolute;
          top: 0.55em;
          width: 0.75em;
        }

        > :where(a) {
          color: var(--user-color-primary);
          fill: var(--user-color-primary);
          text-decoration: none;
        }
      }
    }
  }

  @container (max-width: 767.99px) {
    .LinkList {
      &:where(.columnSp-2) {
        > :where(ul) {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      &:where(.columnSp-3) {
        > :where(ul) {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }

      &:where(.columnSp-4) {
        > :where(ul) {
          grid-template-columns: repeat(4, minmax(0, 1fr));
        }
      }

      &:where(.columnSp-auto) {
        > :where(ul) {
          display: flex;
          flex-wrap: wrap;

          > :where(li) {
            flex: 0 0 auto;
            max-width: 100%;
          }
        }
      }
    }
  }

  @container (min-width: 768px) {
    .LinkList {
      --local-item-gap-x: calc(var(--user-spacing) * 8);

      &:where(.columnPc-2) {
        > :where(ul) {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      &:where(.columnPc-3) {
        > :where(ul) {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }

      &:where(.columnPc-4) {
        > :where(ul) {
          grid-template-columns: repeat(4, minmax(0, 1fr));
        }
      }

      &:where(.columnPc-auto) {
        > :where(ul) {
          display: flex;
          flex-wrap: wrap;

          > :where(li) {
            flex: 0 0 auto;
            max-width: 100%;
          }
        }
      }
    }
  }

  @media (any-hover: hover) {
    .LinkList {
      > :where(ul) {
        > :where(li) {
          > :where(a) {
            &:hover {
              text-decoration: underline;
            }
          }
        }
      }
    }
  }
</style>

---
import type { HTMLAttributes } from 'astro/types';

/**
 * - __このコンポーネントはMarkdown実装やリッチエディタ上では利用できません。__
 */
export interface Props extends HTMLAttributes<'div'> {
  /** PCサイズでの列数を指定します。 */
  columnPc?: '1' | '2' | '3' | '4' | 'auto';
  /** SPサイズでの列数を指定します。 */
  columnSp?: '1' | '2' | '3' | '4' | 'auto';
  /** リンク要素の属性を指定します。`title` はリンクテキストとして表示され、title属性には出力されません。 */
  datas: HTMLAttributes<'a'>[];
}

const { columnPc = '1', columnSp = '1', datas, class: className, ...rest } = Astro.props;
const attrs: Record<string, unknown> = {
  ...rest,
};
---

<div
  class:list={[
    'LinkList',
    columnPc && `columnPc-${columnPc}`,
    columnSp && `columnSp-${columnSp}`,
    className,
  ]}
  {...attrs}
>
  <ul>
    {datas.map(({ title, ...linkAttrs }) => (
      <li>
        <a {...linkAttrs}>{title}</a>
      </li>
    ))}
  </ul>
</div>

<style>
  .LinkList {
    --local-item-gap-x: calc(var(--user-spacing) * 6);
    --local-item-gap-y: calc(var(--user-spacing) * 2);

    > :where(ul) {
      display: grid;
      gap: var(--local-item-gap-y) var(--local-item-gap-x);

      > :where(li) {
        position: relative;
        height: 100%;
        padding-left: 1.25em;
        list-style: none;

        /* arrow */
        &::before {
          position: absolute;
          top: 0.4em;
          left: 0;
          display: block;
          width: 0.75em;
          height: 0.75em;
          content: '';
          background-color: var(--user-color-primary);
          mask-image: url('/assets/images/icons/angle-right.svg');
          mask-repeat: no-repeat;
          mask-size: cover;
        }

        > :where(a) {
          color: var(--user-color-primary);
          text-decoration: none;
          fill: var(--user-color-primary);
        }
      }
    }
  }

  @media (width < 768px) {
    .LinkList {
      &:where(.columnSp-2) {
        > :where(ul) {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      &:where(.columnSp-3) {
        > :where(ul) {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }

      &:where(.columnSp-4) {
        > :where(ul) {
          grid-template-columns: repeat(4, minmax(0, 1fr));
        }
      }

      &:where(.columnSp-auto) {
        > :where(ul) {
          display: flex;
          flex-wrap: wrap;

          > :where(li) {
            flex: 0 0 auto;
            max-width: 100%;
          }
        }
      }
    }
  }

  @media (width >= 768px) {
    .LinkList {
      --local-item-gap-x: calc(var(--user-spacing) * 8);

      &:where(.columnPc-2) {
        > :where(ul) {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      &:where(.columnPc-3) {
        > :where(ul) {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }

      &:where(.columnPc-4) {
        > :where(ul) {
          grid-template-columns: repeat(4, minmax(0, 1fr));
        }
      }

      &:where(.columnPc-auto) {
        > :where(ul) {
          display: flex;
          flex-wrap: wrap;

          > :where(li) {
            flex: 0 0 auto;
            max-width: 100%;
          }
        }
      }
    }
  }

  @media (any-hover: hover) {
    .LinkList {
      > :where(ul) {
        > :where(li) {
          > :where(a) {
            &:hover {
              text-decoration: underline;
            }
          }
        }
      }
    }
  }
</style>

---
import type { HTMLAttributes } from 'astro/types';

/**
 * - __このコンポーネントはMarkdown実装やリッチエディタ上では利用できません。__
 */
export interface Props extends HTMLAttributes<'div'> {}

const { class: className, ...rest } = Astro.props;
const attrs: Record<string, unknown> = {
  ...rest,
};

if (!Astro.slots.has('default')) {
  throw new Error('LayoutGrid: slotの中身が空です。');
}
---

<div
  class:list={[
    'LayoutGrid',
    className,
  ]}
  {...attrs}
>
  <div
    class:list={[
      'LayoutGrid__inner',
    ]}
  >
    {/* @slot 直下では `div.LayoutGrid__segment` の使用のみを許容します。 */}
    <slot />
  </div>
</div>

<style>
  .LayoutGrid {
    :where(.LayoutGrid__inner) {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
    }

    :global(:where(.LayoutGrid__segment)) {
      height: 100%;
      list-style: none;
    }
  }

  @media (width < 768px) {
    .LayoutGrid {
      :where(.LayoutGrid__inner) {
        gap: calc(var(--user-spacing) * 6);
      }

      :global(:where(.LayoutGrid__segment)) {
        &:where(.gridSp-1) {
          grid-column: span 1;
        }

        &:where(.gridSp-2) {
          grid-column: span 2;
        }

        &:where(.gridSp-3) {
          grid-column: span 3;
        }

        &:where(.gridSp-4) {
          grid-column: span 4;
        }

        &:where(.gridSp-5) {
          grid-column: span 5;
        }

        &:where(.gridSp-6) {
          grid-column: span 6;
        }

        &:where(.gridSp-7) {
          grid-column: span 7;
        }

        &:where(.gridSp-8) {
          grid-column: span 8;
        }

        &:where(.gridSp-9) {
          grid-column: span 9;
        }

        &:where(.gridSp-10) {
          grid-column: span 10;
        }

        &:where(.gridSp-11) {
          grid-column: span 11;
        }

        &:where(.gridSp-12) {
          grid-column: span 12;
        }
      }
    }
  }

  @media (width >= 768px) {
    .LayoutGrid {
      :where(.LayoutGrid__inner) {
        gap: calc(var(--user-spacing) * 8);
      }

      :global(:where(.LayoutGrid__segment)) {
        &:where(.gridPc-1) {
          grid-column: span 1;
        }

        &:where(.gridPc-2) {
          grid-column: span 2;
        }

        &:where(.gridPc-3) {
          grid-column: span 3;
        }

        &:where(.gridPc-4) {
          grid-column: span 4;
        }

        &:where(.gridPc-5) {
          grid-column: span 5;
        }

        &:where(.gridPc-6) {
          grid-column: span 6;
        }

        &:where(.gridPc-7) {
          grid-column: span 7;
        }

        &:where(.gridPc-8) {
          grid-column: span 8;
        }

        &:where(.gridPc-9) {
          grid-column: span 9;
        }

        &:where(.gridPc-10) {
          grid-column: span 10;
        }

        &:where(.gridPc-11) {
          grid-column: span 11;
        }

        &:where(.gridPc-12) {
          grid-column: span 12;
        }
      }
    }
  }
</style>

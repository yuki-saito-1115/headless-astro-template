---
import type { HTMLAttributes } from 'astro/types';

/**
 * - __このコンポーネントはMarkdown実装やリッチエディタ上では利用できません。__
 */
export interface Props extends HTMLAttributes<'input'> {
  /** フォームを無効化します。 */
  disabled?: boolean;
  /** フォームのサイズを設定します。 */
  size?: 'small' | 'medium' | 'large' | 'full';
  /** フォームの状態を設定します。 */
  state?: 'valid' | 'invalid';
}

const { disabled = false, size, state, class: className, ...rest } = Astro.props;
const attrs: Record<string, unknown> = {
  ...rest,
};
---

<span
  class:list={[
    'FormText',
    size && `theme-${size}`,
    state && `is-${state}`,
    className,
  ]}
>
  <input
    disabled={disabled}
    class:list={[
      'FormText__item',
    ]}
    {...attrs}
  />
</span>

<style>
  .FormText {
    --local-foreground: var(--user-color-foreground-dark);
    --local-background: var(--user-color-background-light);
    --local-outline: var(--user-color-outline-dark);
    --local-placeholder: var(--color-gray-500);
    --local-width: auto;
    --local-padding: calc(var(--user-spacing) * 3);
    display: inline-flex;
    width: var(--local-width);
    max-width: 100%;
    overflow: hidden;

    border: 1px solid var(--local-outline);

    /* Preflight */
    :where(.FormText__item) {
      /* デフォルトスタイルリセットするため */
      font: unset;

      /* SPでフォーカス時にズームしないために16pxに固定 */
      font-size: var(--text-base); /* 2 */

      /* 要素の中のテキストの高さを限定するため */
      line-height: 1;

      /* ブラウザごとの差異を統一するため */
      color: currentColor;
      appearance: none;
      border-radius: 0;

      /* ブラウザごとの差異を統一しデフォルトスタイルリセットするため */
      ::placeholder {
        font-style: normal;
        color: var(--color-gray-400);
        opacity: 1;
      }
    }

    &:focus-within {
      outline: medium solid currentColor;
    }

    :where(.FormText__item) {
      display: block;
      width: 100%;
      padding: var(--local-padding);
      color: var(--local-foreground);
      appearance: none;
      outline: none;
      background-color: var(--local-background);
      border: 0;

      &::placeholder {
        color: var(--local-placeholder);
        opacity: 0.5;
      }
    }

    &.is-valid,
    :global(&.is-valid) {
      --local-foreground: var(--user-color-success-dark);
      --local-background: var(--user-color-success-light);
      --local-outline: var(--user-color-success-dark);
      --local-placeholder: var(--local-foreground);
    }

    &.is-invalid,
    :global(&.is-invalid) {
      --local-foreground: var(--user-color-danger-dark);
      --local-background: var(--user-color-danger-light);
      --local-outline: var(--user-color-danger-dark);
      --local-placeholder: var(--local-foreground);
    }

    &:has(:disabled) {
      --local-foreground: var(--user-color-disabled-dark);
      --local-background: var(--user-color-disabled-light);
      --local-outline: var(--user-color-disabled-light);
      --local-placeholder: var(--local-foreground);

      :is(.FormText__item) {
        cursor: not-allowed;
      }
    }

    &.theme-small {
      --local-width: 25%;
    }

    &.theme-medium {
      --local-width: 50%;
    }

    &.theme-large {
      --local-width: 75%;
    }

    &.theme-full {
      --local-width: 100%;
    }
  }
</style>

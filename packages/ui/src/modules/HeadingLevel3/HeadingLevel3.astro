---
import type { HTMLAttributes } from 'astro/types';

/**
 * - __このコンポーネントはmicroCMSのリッチエディタの [見出し、段落](https://document.microcms.io/manual/rich-editor-usage#hdec08ed8b7) と関連しています。__
 */
export interface Props extends HTMLAttributes<'div'> {}

const { class: className, ...rest } = Astro.props;
const attrs: Record<string, unknown> = { ...rest };

if (!Astro.slots.has('default')) {
  throw new Error('HeadingLevel3: slotの中身が空です。');
}
---

<div
  class:list={['HeadingLevel3', className]}
  {...attrs}
>
  <slot />
</div>


<style>
  .HeadingLevel3 {
    :where(h1, h2, h3, h4, h5, h6) {
      font-weight: var(--user-font-weight-bold);
      color: var(--user-color-foreground-dark);
      padding-bottom: calc(var(--user-spacing) * 4);
      position: relative;
      line-height: var(--text-xl--line-height);
      font-size: var(--text-xl);

      /* border */
      &::before {
        background-color: var(--user-color-primary);
        bottom: 0;
        content: '';
        display: block;
        height: 1px;
        left: 0;
        position: absolute;
        width: 100%;
      }

      :where(a) {
        color: var(--user-color-primary);
        text-decoration: none;
      }
    }
  }

  @media (width >= 768px) {
    .HeadingLevel3 {
      :where(h1, h2, h3, h4, h5, h6) {
        line-height: var(--text-2xl--line-height);
        font-size: var(--text-2xl);
      }
    }
  }

  @media (any-hover: hover) {
    .HeadingLevel3 {
      :where(h1, h2, h3, h4, h5, h6) {
        :where(a) {
          &:hover {
            text-decoration: underline;
          }
        }
      }
    }
  }
</style>

---
import type { HTMLAttributes } from 'astro/types';

/**
 * - __このコンポーネントはMarkdown実装やリッチエディタ上では利用できません。__
 */
export interface Props extends HTMLAttributes<'div'> {
  /** SP幅時のコンテンツと画像の並び方向を設定します。 */
  directSp?: 'row' | 'row-reverse' | 'column' | 'column-reverse';
  /** PC幅時のコンテンツと画像の並び方向を設定します。 */
  directPc?: 'row' | 'row-reverse' | 'column' | 'column-reverse';
}

const {
  directSp = 'column-reverse',
  directPc = 'row',
  class: className,
  ...rest
} = Astro.props;
const attrs: Record<string, unknown> = { ...rest };

if (!Astro.slots.has('content') || !Astro.slots.has('media')) {
  throw new Error('LayoutMedia: content slotまたはmedia slotが空です。');
}
---
<div
  class:list={[
    'LayoutMedia',
    className,
  ]}
  {...attrs}
>
  <div
    class:list={[
      'LayoutMedia__inner',
      directSp && `directSp-${directSp}`,
      directPc && `directPc-${directPc}`,
    ]}
  >
    <div class="LayoutMedia__segment">
      <slot name="content" />
    </div>

    <div class="LayoutMedia__segment">
      <slot name="media" />
    </div>
  </div>
</div>


<style>
  .LayoutMedia {
    :where(.LayoutMedia__inner) {
      display: grid;
      gap: calc(var(--user-spacing) * 4);
      grid-template-columns: minmax(0, 1fr) fit-content(50%);
    }

    :where(.LayoutMedia__segment) {
      direction: ltr;
    }
  }

  @media (width < 768px) {
    .LayoutMedia {
      :where(.LayoutMedia__inner) {
        gap: calc(var(--user-spacing) * 4);

        &:where(.directSp-row-reverse) {
          direction: rtl;
        }

        &:where(.directSp-column, .directSp-column-reverse) {
          display: flex;
        }

        &:where(.directSp-column) {
          flex-direction: column;
        }

        &:where(.directSp-column-reverse) {
          flex-direction: column-reverse;
        }
      }
    }
  }

  @media (width >= 768px) {
    .LayoutMedia {
      :where(.LayoutMedia__inner) {
        gap: calc(var(--user-spacing) * 6);

        &:where(.directPc-row-reverse) {
          direction: rtl;
        }

        &:where(.directPc-column, .directPc-column-reverse) {
          display: flex;
        }

        &:where(.directPc-column) {
          flex-direction: column;
        }

        &:where(.directPc-column-reverse) {
          flex-direction: column-reverse;
        }
      }
    }
  }
</style>

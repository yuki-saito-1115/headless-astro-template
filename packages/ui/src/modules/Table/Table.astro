---
import type { HTMLAttributes } from 'astro/types';

/**
 * - __このコンポーネントはmicroCMSのリッチエディタの [テーブル](https://document.microcms.io/manual/rich-editor-usage#h361fd99869) と関連しています。__
 */
export interface Props extends HTMLAttributes<'div'> {
  /** SP幅時のテーブルの並び方向を設定します。ただしこのPropsはリッチエディタでは利用できません。 */
  directSp?: 'row' | 'column';
  /** PC幅時にテーブルを横スクロールで表示します。ただしこのPropsはリッチエディタでは利用できません。 */
  scrollPc?: boolean;
  /** SP幅時にテーブルを横スクロールで表示します。ただしこのPropsはリッチエディタでは利用できません。 */
  scrollSp?: boolean;
}

const { directSp = 'row', scrollSp = false, scrollPc = false, class: className, ...rest } = Astro.props;
const attrs: Record<string, unknown> = {
  ...rest,
};

if (!Astro.slots.has('default')) {
  throw new Error('Table: slotの中身が空です。');
}
---

<div
  class:list={[
    'Table',
    directSp && `directSp-${directSp}`,
    scrollSp && 'scrollSp',
    scrollPc && 'scrollPc',
    className,
  ]}
  {...attrs}
>
  {/* @slot このslotの直下では、クラス名無しの `table` 要素の使用のみを許容します。 */}
  <slot />
</div>

<style>
  .Table {
    :where(table) {
      width: 100%;
      table-layout: fixed;
      border-collapse: collapse;
      background-color: var(--user-color-background-light);
      border-top: 1px solid var(--user-color-foreground-dark);
      border-left: 1px solid var(--user-color-foreground-dark);
    }

    :where(th, td) {
      padding: calc(var(--user-spacing) * 4);
      border-right: 1px solid var(--user-color-foreground-dark);
      border-bottom: 1px solid var(--user-color-foreground-dark);
    }

    :where(th) {
      font-weight: var(--user-font-weight-bold);
      text-align: center;
      background-color: var(--color-gray-200);
    }
  }

  @media (width < 768px) {
    .Table {
      &:where(.directSp-column) {
        :where(table, tbody, tr, th, td) {
          display: block;
          width: 100%;
        }
      }

      &:where(.scrollSp) {
        position: relative;
        overflow: auto;

        &:where(.is-scrollGuide) {
          &::before,
          &::after {
            position: absolute;
            top: min(50%, calc(var(--user-spacing) * 28));
            left: 50%;
            width: auto;
            height: min(calc(100% - (var(--user-spacing) * 2)), calc(var(--user-spacing) * 18));
            aspect-ratio: 1;
            pointer-events: none;
            content: '';
            transform: translate(-50%, -50%);
          }

          &::before {
            background-color: var(--user-color-foreground-dark);
            border-radius: 50%;
            opacity: 0.75;
          }

          &::after {
            background-color: var(--user-color-foreground-light);
            mask-image: url('/assets/images/icons/arrow-right.svg');
            mask-repeat: no-repeat;
            mask-position: center;
            mask-size: 60%;
          }
        }

        :where(table) {
          width: calc(var(--user-major-breakpoint) - 1px);
        }
      }
    }
  }

  @media (width >= 768px) {
    .Table {
      &:where(.scrollPc) {
        overflow: auto;

        :where(table) {
          width: var(--user-content-width-pc);
        }
      }

      :where(th, td) {
        padding: calc(var(--user-spacing) * 4) calc(var(--user-spacing) * 6);
      }
    }
  }
</style>

<script is:inline>
  /** SP幅で横スクロールするテーブルに、初回だけスクロール操作のガイドを表示する。 */
  const setTable = (root) => {
    if (!root.classList.contains('scrollSp')) {
      return;
    }

    /** 最初のスクロールでガイドを消す。 */
    const bindEvent = () => {
      root.addEventListener('scroll', () => root.classList.remove('is-scrollGuide'), {
        once: true,
      });
    };

    /** スクロール前のガイドを表示する。 */
    const build = () => {
      root.classList.add('is-scrollGuide');
    };

    build();
    bindEvent();
  };

  (() => {
    const elements = document.querySelectorAll('.Table');

    elements.forEach((element) => {
      if (element.dataset.initialized) {
        return;
      }

      setTable(element);
      element.dataset.initialized = 'true';
    });
  })();
</script>

---
import type { HTMLAttributes } from 'astro/types';

/**
 * - __このコンポーネントはmicroCMSのリッチエディタの [テーブル](https://document.microcms.io/manual/rich-editor-usage#h361fd99869) と関連しています。__
 */
export interface Props extends HTMLAttributes<'div'> {}

const { class: className, ...rest } = Astro.props;
const attrs: Record<string, unknown> = { ...rest };

if (!Astro.slots.has('default')) {
  throw new Error('Table: slotの中身が空です。');
}
---

<div
  class:list={[
    'Table',
    className
  ]}
  {...attrs}
>
  <slot />
</div>


<style>
  .Table {
  }
</style>

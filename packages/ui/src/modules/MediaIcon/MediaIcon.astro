---

<svg
  viewBox="0 0 160 160"
  class:list={[
    'MediaIcon',
    className,
  ]}
  {...attrs}
>
  <title>{title ?? icon[name][lang]}</title>
  <Fragment set:html={icon[name].item} />
</svg>

<style>
  .MediaIcon {
    display: inline-block;
    flex: 0 0 auto;
    width: 1em;
    height: 1em;
    vertical-align: baseline;
    color: currentColor;
  }
</style>

---
import type { HTMLAttributes } from 'astro/types';

/**
 * -  __このコンポーネントはmicroCMSのリッチエディタの [リスト](https://document.microcms.io/manual/rich-editor-usage#h4334dcd5e5)、[番号付きリスト](https://document.microcms.io/manual/rich-editor-usage#h8baf1c3620) と関連しています。__
 */
export interface Props extends HTMLAttributes<'div'> {
  /** PCサイズでの列数を指定します。 */
  columnPc?: '1' | '2' | '3' | '4' | '5' | 'auto';
  /** SPサイズでの列数を指定します。 */
  columnSp?: '1' | '2' | '3' | '4' | '5' | 'auto';
  /** スタイルを設定できます。ただしこのPropsはリッチエディタでは利用できません。 */
  note?: boolean;
}

const {
  columnPc = '1',
  columnSp = '1',
  note = false,
  class: className,
  ...rest
} = Astro.props;
const attrs: Record<string, unknown> = { ...rest };

if (!Astro.slots.has('default')) {
  throw new Error('List: slotの中身が空です。');
}
---

<div
  class:list={[
    'List',
    note && 'theme-note',
    columnPc && `columnPc-${columnPc}`,
    columnSp && `columnSp-${columnSp}`,
    className
  ]}
  {...attrs}
>
  <slot />
</div>


<style>
  .List {
    --local-item-gap-x: calc(var(--user-spacing) * 6);
    --local-item-gap-y: calc(var(--user-spacing) * 2);

    container-type: inline-size;

    :where(ol, ul) {
      display: grid;
      gap: var(--local-item-gap-y) var(--local-item-gap-x);
      padding-left: 2em;

      :where(ol, ul) {
        margin-top: var(--local-item-gap-y);
      }
    }

    :where(ol, ul) {
      counter-reset: list-item;
    }

    :where(li) {
      height: 100%;
      position: relative;

      &[value] {
        list-style: none;

        &::before {
          content: attr(value) '. ';
          left: -2em;
          position: absolute;
          top: 0;
        }
      }
    }

    :where(ul) {
      > :where(li) {
        list-style: none;

        &:not([value])::before {
          background-color: var(--user-color-primary);
          border-radius: 50%;
          content: '';
          display: block;
          height: 6px;
          left: -1em;
          position: absolute;
          top: 0.75em;
          width: 6px;
        }
      }
    }

    :where(ol) {
      > :where(li) {
        list-style: none;

        &:not([value]) {
          counter-increment: list-item;

          &::before {
            content: counter(list-item) '. ';
            left: -2em;
            position: absolute;
            top: 0;
          }
        }
      }
    }

    &.theme-note {
      :where(ul) {
        > :where(li) {
          font-size: var(--font-size-xs);

          &:not([value])::before {
            all: revert;
            content: '※';
            left: -1.2em;
            position: absolute;
            top: 0;
          }
        }
      }

      :where(ol) {
        > :where(li) {
          font-size: var(--font-size-xs);

          &:not([value])::before {
            content: '※' counter(list-item) ' ';
            left: -2em;
          }

          &[value]::before {
            content: '※' attr(value) ' ';
          }
        }
      }
    }
  }

</style>

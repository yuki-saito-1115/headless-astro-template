---
import type { HTMLAttributes } from 'astro/types';

/**
 * - __このコンポーネントはmicroCMSのリッチエディタの [リスト](https://document.microcms.io/manual/rich-editor-usage#h4334dcd5e5)、[番号付きリスト](https://document.microcms.io/manual/rich-editor-usage#h8baf1c3620) と関連しています。__
 */
export interface Props extends HTMLAttributes<'div'> {
  /** PCサイズでの列数を指定します。ただし、この設定を利用するときは入れ子は使用できません。また、このPropsはリッチエディタでは利用できません。 */
  columnPc?: '1' | '2' | '3' | '4' | 'auto';
  /** SPサイズでの列数を指定します。ただし、この設定を利用するときは入れ子は使用できません。また、このPropsはリッチエディタでは利用できません。 */
  columnSp?: '1' | '2' | '3' | '4' | 'auto';
  /** 表示テーマを設定します。 */
  theme?: 'note';
}

const { columnPc = '1', columnSp = '1', theme, class: className, ...rest } = Astro.props;
const attrs: Record<string, unknown> = {
  ...rest,
};

if (!Astro.slots.has('default')) {
  throw new Error('List: slotの中身が空です。');
}
---

<div
  class:list={[
    'List',
    theme && `theme-${theme}`,
    columnPc && `columnPc-${columnPc}`,
    columnSp && `columnSp-${columnSp}`,
    className,
  ]}
  {...attrs}
>
  {/* @slot このslotの直下では、クラス名無しの `ul` 要素または `ol` 要素の使用のみを許容します。 */}
  <slot />
</div>

<style>
  @counter-style list-number-default {
    system: extends decimal;
    suffix: '. ';
  }

  .List {
    --local-item-gap-x: calc(var(--user-spacing) * 6);
    --local-item-gap-y: calc(var(--user-spacing) * 2);

    :global(:where(ol, ul)) {
      display: grid;
      gap: var(--local-item-gap-y) var(--local-item-gap-x);
      padding-left: 1.7em;

      :global(:where(li)) {
        position: relative;
        height: 100%;
      }
    }

    :global(:where(ul)) {
      > :global(:where(li)) {
        list-style: none;

        &::before {
          position: absolute;
          top: 0.7em;
          left: -1.7em;
          display: block;
          width: 6px;
          height: 6px;
          content: '';
          background-color: var(--user-color-secondary2);
          border-radius: 50%;
        }
      }
    }

    :global(:where(ol)) {
      > :global(:where(li)) {
        list-style: list-number-default;
      }
    }

    &:where(.theme-note) {
      :global(:where(ol, ul)) {
        padding-left: 3em;
        font-size: var(--text-sm);
        font-weight: var(--user-font-weight-normal);
      }

      :global(:where(ul)) {
        padding-left: 1.5em;

        > :global(:where(li)) {
          &::before {
            top: 0;
            left: -1.5em;
            width: auto;
            height: auto;
            content: '※';
            background-color: transparent;
            border-radius: 0;
          }
        }
      }

      :global(:where(ol)) {
        counter-reset: list-item;

        > :global(:where(li)) {
          list-style: none;
          counter-increment: list-item;

          &[value] {
            counter-set: list-item attr(value type(<integer>));
          }

          &::before {
            position: absolute;
            top: 0;
            left: -3em;
            content: '※' counter(list-item);
          }
        }
      }
    }

    :global(:where(ol, ul)) {
      :global(:where(ol, ul)) {
        margin-top: var(--local-item-gap-y);
      }
    }
  }

  @media (width < 768px) {
    .List {
      &:where(.columnSp-2) {
        > :global(:where(ol, ul)) {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      &:where(.columnSp-3) {
        > :global(:where(ol, ul)) {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }

      &:where(.columnSp-4) {
        > :global(:where(ol, ul)) {
          grid-template-columns: repeat(4, minmax(0, 1fr));
        }
      }

      &:where(.columnSp-5) {
        > :global(:where(ol, ul)) {
          grid-template-columns: repeat(5, minmax(0, 1fr));
        }
      }

      &:where(.columnSp-auto) {
        > :global(:where(ol, ul)) {
          display: flex;
          flex-wrap: wrap;

          > :global(:where(li)) {
            flex: 0 0 auto;
            max-width: 100%;
          }
        }
      }
    }
  }

  @media (width >= 768px) {
    .List {
      --local-item-gap-x: calc(var(--user-spacing) * 8);

      &:where(.columnPc-2) {
        > :global(:where(ol, ul)) {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      &:where(.columnPc-3) {
        > :global(:where(ol, ul)) {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }

      &:where(.columnPc-4) {
        > :global(:where(ol, ul)) {
          grid-template-columns: repeat(4, minmax(0, 1fr));
        }
      }

      &:where(.columnPc-5) {
        > :global(:where(ol, ul)) {
          grid-template-columns: repeat(5, minmax(0, 1fr));
        }
      }

      &:where(.columnPc-auto) {
        > :global(:where(ol, ul)) {
          display: flex;
          flex-wrap: wrap;

          > :global(:where(li)) {
            flex: 0 0 auto;
            max-width: 100%;
          }
        }
      }
    }
  }
</style>

---
import type { Props as MediaIconProps } from '@packages/ui/modules/MediaIcon/MediaIcon.astro';
import MediaIcon from '@packages/ui/modules/MediaIcon/MediaIcon.astro';
import type { Polymorphic } from 'astro/types';

/**
 * - __このコンポーネントはMarkdown実装やリッチエディタ上では利用できません。__
 */
export type Props<
  Tag extends 'span' | 'a' | 'button' = 'span' | 'a' | 'button',
> = Polymorphic<{
  as: Tag;
}> & {
  /** 出力する要素を設定します。要素を選択すると、その要素の属性を指定できます。省略すると非活性状態の `"span"` になります。 */
  as?: Tag;
  /** テキストノード以外の使用を禁止します。 */
  title: string;
  /** ボタンの前に表示するアイコンを設定できます。`Media/Icon` コンポーネントが受け取るPropsと同じ形式で指定してください。 */
  iconBefore?: MediaIconProps;
  /** ボタンの後に表示するアイコンを設定できます。`Media/Icon` コンポーネントが受け取るPropsと同じ形式で指定してください。 */
  iconAfter?: MediaIconProps;
  /** 配色を設定できます。セマンティクスに変化はありません。 */
  theme?: 'emphasis' | 'conversion' | 'text';
};

const {
  as: Element = 'span',
  title,
  iconAfter = undefined,
  iconBefore = undefined,
  theme = undefined,
  class: className,
  ...rest
} = Astro.props;
const attrs: Record<string, unknown> = { ...rest };

switch (Element) {
  case 'a':
    delete attrs.disabled;
    delete attrs.type;
    break;
  case 'button':
    delete attrs.href;
    break;
  default:
    delete attrs.disabled;
    delete attrs.href;
    delete attrs.type;
    break;
}
---

<Element
  class:list={[
    'Button',
    theme && `theme-${theme}`,
    className,
  ]}
  {...attrs}
>
  {iconBefore && <MediaIcon class:list={['Button__icon']} {...iconBefore} />}

  <span class:list={['Button__content']}>{title}</span>

  {iconAfter && <MediaIcon class:list={['Button__icon']} {...iconAfter} />}
</Element>


<style>
  .Button {
    --local-foreground: var(--user-color-primary);
    --local-background: var(--user-color-background-light);
    --local-outline: var(--user-color-primary);

    align-items: center;
    background-color: var(--local-background);
    border: 1px solid var(--local-outline);
    color: var(--local-foreground);
    cursor: pointer;
    display: inline-flex;
    fill: var(--local-foreground);
    /* button要素はフォントを継承しないため */
    font: inherit;
    font-weight: normal;
    gap: 0.5em;
    justify-content: center;
    /* button要素は文字間隔を継承しないため */
    letter-spacing: inherit;
    line-height: 1.5;
    padding: calc(var(--user-spacing) * 4) calc(var(--user-spacing) * 6);
    text-align: center;
    text-decoration: none;
    vertical-align: middle;

    /* 強調 */
    &:where(.theme-emphasis) {
      --local-foreground: var(--user-color-foreground-light);
      --local-background: var(--user-color-primary);
      --local-outline: var(--user-color-primary);
    }

    /* コンバージョン */
    &:where(.theme-conversion) {
      --local-foreground: var(--user-color-foreground-light);
      --local-background: var(--user-color-danger-dark);
      --local-outline: var(--user-color-danger-dark);
    }

    /* テキスト */
    &:where(.theme-text) {
      --local-foreground: var(--user-color-foreground-dark);
      --local-background: transparent;
      --local-outline: transparent;

      fill: var(--user-color-primary);
      min-width: unset;
      padding: unset;
      vertical-align: baseline;
    }

    /* 非活性 */
    &:is(span, :disabled) {
      --local-foreground: var(--user-color-disabled-dark);
      --local-background: var(--user-color-disabled-light);
      --local-outline: var(--user-color-disabled-light);

      cursor: text;
    }

    > :where(.Button__icon) {
      color: currentColor;
      display: inline-block;
      flex: 0 0 auto;
      height: 1em;
      vertical-align: baseline;
      width: 1em;
    }
  }

  @media (any-hover: hover) {
    .Button:not(span, :disabled) {
      /* 強調 */
      &:where(.theme-emphasis) {
        &:hover {
          --local-foreground: var(--user-color-primary);
          --local-background: var(--user-color-background-light);
          --local-outline: var(--user-color-primary);
        }
      }

      /* コンバージョン */
      &:where(.theme-conversion) {
        &:hover {
          --local-foreground: var(--user-color-danger-dark);
          --local-background: var(--user-color-background-light);
          --local-outline: var(--user-color-danger-dark);
        }
      }

      /* テキスト */
      &:where(.theme-text) {
        &:hover {
          --local-foreground: var(--user-color-primary);
          --local-background: transparent;
          --local-outline: transparent;

          text-decoration: underline;
        }
      }

      &:hover {
        --local-foreground: var(--user-color-foreground-light);
        --local-background: var(--user-color-primary);
        --local-outline: var(--user-color-primary);
      }
    }
  }
</style>

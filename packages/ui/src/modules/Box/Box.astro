---
import type { Polymorphic } from 'astro/types';

/**
 * - __このコンポーネントはMarkdown実装やリッチエディタ上では利用できません。__
 */
export type Props<Tag extends 'div' | 'details' = 'div' | 'details'> =
  Polymorphic<{
    as: Tag;
  }> & {
    /** 出力する要素を設定します。要素を選択すると、その要素の属性を指定できます。省略すると `div` 要素になります。 */
    as?: Tag;
    /** コンテンツ部分をスクロールさせるかどうかを指定します。`true` の場合はコンテンツ部分の高さが `200px` に固定されます。 */
    scroll?: boolean;
    /** 配色を設定できます。セマンティクスに変化はありません。 */
    theme?: 'related' | 'important' | 'alert' | undefined;
    /** テキストノード以外の使用を禁止します。必要ない場合は省略可能ですが `as` が `"details"` の場合は省略することができません。 */
    title?: string;
    /** タイトル部分のHTML要素を指定します。`as` が `"details"` の場合は強制的に `"summary"` が設定されます。 */
    titleElement?: 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6' | 'div';
  };

const {
  as: Element = 'div',
  scroll = false,
  theme = undefined,
  title = undefined,
  titleElement = 'div',
  class: className,
  ...rest
} = Astro.props;
const attrs: Record<string, unknown> = { ...rest };
const TitleElement = Element === 'details' ? 'summary' : titleElement;

switch (Element) {
  case 'details':
    break;
  default:
    delete attrs.open;
    break;
}

if (!Astro.slots.has('default')) {
  throw new Error('Box: slotの中身が空です。');
}

if (Element === 'details' && !title) {
  throw new Error('Box: `as` が `details` の場合は `title` を省略できません。');
}
---

<Element
  class:list={[
    'Box',
    theme && `theme-${theme}`,
    scroll && 'theme-scroll',
    className,
  ]}
  {...attrs}
>
  {title && (
    <TitleElement class:list={['Box__head']}>
      <span class:list={['Box__title']}>{title}</span>
    </TitleElement>
  )}

  <div class:list={['Box__body']}>
    <slot />
  </div>
</Element>


<style>
  .Box {
    --local-foreground: var(--user-color-foreground-dark);
    --local-background: var(--color-gray-100);
    --local-outline: transparent;
    --local-padding: calc(var(--user-spacing) * 4);

    background-color: var(--local-background);
    border: 1px solid var(--local-outline);
    padding-bottom: var(--local-padding);
    padding-top: var(--local-padding);

    &:has(:where(.Box__head)) {
      padding-top: 0;
    }

    &:where(.theme-related) {
      --local-background: var(--user-color-background-light);
      --local-outline: var(--user-color-outline-dark);
    }

    &:where(.theme-important) {
      --local-background: var(--user-color-danger-light);
      --local-outline: transparent;
    }

    &:where(.theme-alert) {
      --local-foreground: var(--user-color-danger-dark);
      --local-background: var(--user-color-background-light);
      --local-outline: var(--user-color-danger-dark);

      > :where(.Box__head) {
        text-align: center;
      }
    }

    &:where(.theme-scroll) {
      > :where(.Box__body) {
        height: 200px;
        overflow: auto;
        position: relative;
      }
    }

    :where(.Box__head) {
      color: var(--local-foreground);
      padding: var(--local-padding);
    }

    :where(.Box__title) {
      font-weight: var(--user-font-weight-bold);
      font-size: var(--text-lg);
      line-height: var(--text-lg--line-height);
    }

    :where(.Box__body) {
      padding: 0 var(--local-padding);

      > :is(:first-child) {
        margin-top: 0;
      }

      > :is(:last-child) {
        margin-bottom: 0;
      }
    }

    &:where(details) {
      padding-bottom: 0;

      > :where(.Box__head) {
        list-style: none;
        cursor: pointer;
        position: relative;

        /* icon */
        &::before {
          background-color: currentColor;
          content: '';
          display: block;
          height: 16px;
          mask-image: url('/assets/images/icons/plus.svg');
          mask-repeat: no-repeat;
          mask-size: cover;
          pointer-events: none;
          position: absolute;
          right: var(--local-padding);
          top: 50%;
          transform: translateY(-50%);
          width: 16px;
        }
      }

      &:where([open]) {
        padding-bottom: var(--local-padding);

        > :where(.Box__head) {
          &::before {
            mask-image: url('/assets/images/icons/minus.svg');
          }
        }
      }
    }
  }


  @media (width >= 768px) {
    .Box {
      --local-padding: calc(var(--user-spacing) * 8);

      :where(.Box__title) {
        font-size: var(--text-xl);
        line-height: var(--text-xl--line-height);
      }
    }
  }
</style>

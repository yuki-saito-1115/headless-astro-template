---
import type { Polymorphic } from 'astro/types';

/**
 * - __このコンポーネントはMarkdown実装やリッチエディタ上では利用できません。__
 */
export type Props<Tag extends 'div' | 'details' = 'div' | 'details'> = Polymorphic<{
  as: Tag;
}> & {
  /** 出力する要素を設定します。要素を選択すると、その要素の属性を指定できます。省略すると `div` 要素になります。 */
  as?: Tag;
  /** コンテンツ部分をスクロールさせるかどうかを指定します。`true` の場合はコンテンツ部分の高さが `200px` に固定されます。 */
  scroll?: boolean;
  /** 配色を設定できます。セマンティクスに変化はありません。 */
  theme?: 'related' | 'important' | 'alert' | undefined;
  /** テキストノード以外の使用を禁止します。必要ない場合は省略可能ですが `as` が `"details"` の場合は省略することができません。 */
  title?: string;
  /** タイトル部分のHTML要素を指定します。`as` が `"details"` の場合は強制的に `"summary"` が設定されます。 */
  titleElement?: 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6' | 'div';
};

const {
  as: Element = 'div',
  scroll = false,
  theme = undefined,
  title = undefined,
  titleElement = 'div',
  class: className,
  ...rest
} = Astro.props;
const attrs: Record<string, unknown> = {
  ...rest,
};
const TitleElement = Element === 'details' ? 'summary' : titleElement;

switch (Element) {
  case 'details':
    break;
  default:
    delete attrs.open;
    break;
}

if (!Astro.slots.has('default')) {
  throw new Error('Box: slotの中身が空です。');
}

if (Element === 'details' && !title) {
  throw new Error('Box: `as` が `details` の場合は `title` を省略できません。');
}
---

<Element
  class:list={[
    'Box',
    theme && `theme-${theme}`,
    scroll && 'theme-scroll',
    className,
  ]}
  {...attrs}
>
  {title && (
    <TitleElement
      class:list={[
        'Box__head',
      ]}
    >
      <span
        class:list={[
          'Box__title',
        ]}
      >
        {title}
      </span>
    </TitleElement>
  )}

  <div
    class:list={[
      'Box__body',
    ]}
  >
    {/* @slot あらゆるコンポーネント・HTML要素・テキストノードの使用を許容します。 */}
    <slot />
  </div>
</Element>

<style>
  .Box {
    --local-background: var(--color-gray-100);
    --local-foreground: var(--user-color-foreground-dark);
    --local-outline: transparent;
    --local-padding-x: calc(var(--user-spacing) * 4);
    --local-padding-y: calc(var(--user-spacing) * 6);

    padding-top: var(--local-padding-y);
    padding-bottom: var(--local-padding-y);
    background-color: var(--local-background);
    border: 1px solid var(--local-outline);

    &:has(:where(.Box__head)) {
      padding-top: 0;
    }

    &:where(.theme-related) {
      --local-background: var(--user-color-background-light);
      --local-outline: var(--user-color-outline-dark);

      > :where(.Box__head) {
        background-color: var(--color-gray-200);
      }

      > :where(.Box__head + .Box__body) {
        padding-top: var(--local-padding-y);
      }
    }

    &:where(.theme-important) {
      --local-background: var(--user-color-danger-light);
      --local-outline: transparent;
    }

    &:where(.theme-alert) {
      --local-background: var(--user-color-background-light);
      --local-foreground: var(--user-color-danger-dark);
      --local-outline: var(--user-color-danger-dark);

      > :where(.Box__head) {
        text-align: center;
      }
    }

    &:where(.theme-scroll) {
      > :where(.Box__body) {
        position: relative;
        height: 200px;
        overflow: auto;
      }
    }

    :where(.Box__head) {
      padding: var(--local-padding-y) var(--local-padding-x);
      color: var(--local-foreground);
    }

    :where(.Box__title) {
      font-size: var(--text-lg);
      font-weight: var(--user-font-weight-bold);
      line-height: var(--text-lg--line-height);
    }

    :where(.Box__body) {
      padding: 0 var(--local-padding-x);
    }

    &:where(details) {
      padding-bottom: 0;

      > :where(.Box__head) {
        position: relative;
        cursor: pointer;
        list-style: none;

        /* icon */
        &::before {
          position: absolute;
          top: 50%;
          right: var(--local-padding-x);
          display: block;
          width: 16px;
          height: 16px;
          pointer-events: none;
          content: '';
          background-color: currentColor;
          mask-image: url('/assets/images/icons/plus.svg');
          mask-repeat: no-repeat;
          mask-size: cover;
          transform: translateY(-50%);
        }
      }

      &:where([open]) {
        padding-bottom: var(--local-padding-y);

        > :where(.Box__head) {
          &::before {
            mask-image: url('/assets/images/icons/minus.svg');
          }
        }
      }
    }
  }

  @media (width >= 768px) {
    .Box {
      --local-padding-x: calc(var(--user-spacing) * 8);

      &:where(.theme-scroll) {
        > :where(.Box__body) {
          height: 300px;
        }
      }

      :where(.Box__title) {
        font-size: var(--text-xl);
        line-height: var(--text-xl--line-height);
      }
    }
  }
</style>

---
import type { HTMLAttributes } from 'astro/types';

/**
 * - __このコンポーネントはmicroCMSのリッチエディタの [リンク](https://document.microcms.io/manual/rich-editor-usage#he4ba96ecb5) と関連しています。__
 */
export interface Props extends HTMLAttributes<'span'> {}

const { class: className, ...rest } = Astro.props;
const attrs: Record<string, unknown> = { ...rest };

if (!Astro.slots.has('default')) {
  throw new Error('Link: slotの中身が空です。');
}
---

<span
  class:list={[
    'Link',
    className
  ]}
  {...attrs}
>
  <slot />
</span>


<style>
  .Link {
    :where(a) {
      color: var(--user-color-primary);
      text-decoration: none;
      fill: var(--user-color-primary);
    }
  }

  @media (any-hover: hover) {
    .Link {
      :where(a) {
        &:hover {
          text-decoration: underline;
        }
      }
    }
  }
</style>

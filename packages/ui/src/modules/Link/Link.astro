---
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'span'> {}

const { class: className, ...rest } = Astro.props;
const slotHtml = await Astro.slots.render('default');
---

<span
  class:list={[className, 'Link']}
  {...rest}
>
  {slotHtml && <Fragment set:html={slotHtml} />}
</span>


<style>
  .Link {
    :where(a) {
      color: var(--user-color-primary);
      text-decoration: none;
      fill: var(--user-color-primary);
    }
  }

  @media (any-hover: hover) {
    .Link {
      :where(a) {
        &:hover {
          text-decoration: underline;
        }
      }
    }
  }
</style>

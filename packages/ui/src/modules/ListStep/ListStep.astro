---
import type { HTMLAttributes } from 'astro/types';

/**
 * - __このコンポーネントはMarkdown実装やリッチエディタ上では利用できません。__
 */
export interface Props extends HTMLAttributes<'ol'> {
  /** 手順の内容を設定します。 */
  datas: {
    /** 手順のタイトルを設定します。 */
    title: string;
    /** 手順の説明を設定します。 */
    text: string;
  }[];
}

const { datas, class: className, ...rest } = Astro.props;
const attrs: Record<string, unknown> = {
  ...rest,
};
---

<ol
  class:list={[
    'ListStep',
    className,
  ]}
  {...attrs}
>
  {datas.map((data) => (
    <li>
      <span class="ListStep__title">{data.title}</span>
      <span class="ListStep__text">{data.text}</span>
    </li>
  ))}
</ol>

<style>
  .ListStep {
    --local-arrow-height: calc(var(--user-spacing) * 3);
    display: flex;
    flex-direction: column;
    gap: calc(var(--user-spacing) * 5);

    counter-reset: step;

    :where(li) {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: calc(var(--user-spacing) * 4);
      padding: calc(var(--user-spacing) * 4);
      list-style: none;
      counter-increment: step;
      background-color: var(--color-gray-200);

      &:not(:last-child) {
        &::before {
          position: absolute;
          top: 100%;
          left: 50%;
          content: '';
          border-top: var(--local-arrow-height) solid var(--color-gray-200);
          border-right: calc(var(--user-spacing) * 3) solid transparent;
          border-left: calc(var(--user-spacing) * 3) solid transparent;
          transform: translateX(-50%);
        }
      }
    }

    :where(.ListStep__title) {
      position: relative;
      padding-left: calc(var(--user-spacing) * 10);
      font-weight: var(--user-font-weight-bold);

      &::before {
        position: absolute;
        top: 50%;
        left: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        width: calc(var(--user-spacing) * 8);
        height: calc(var(--user-spacing) * 8);
        line-height: 1;
        color: var(--user-color-foreground-light);
        content: counter(step);
        background-color: var(--user-color-secondary2);
        transform: translateY(-50%);
      }
    }
  }

  @media (width >= 768px) {
    .ListStep {
      gap: calc(var(--user-spacing) * 8);

      :where(li) {
        flex-direction: row;
        gap: calc(var(--user-spacing) * 6);
        align-items: center;
      }

      :where(.ListStep__title, .ListStep__text) {
        flex: 0 1 auto;
        max-width: 50%;
      }

      :where(.ListStep__title) {
        padding-left: calc(var(--user-spacing) * 14);

        &::before {
          width: calc(var(--user-spacing) * 10);
          height: calc(var(--user-spacing) * 10);
        }
      }
    }
  }
</style>

---
import type { HTMLAttributes } from 'astro/types';

/**
 * - __このコンポーネントはmicroCMSのリッチエディタの [画像](https://document.microcms.io/manual/rich-editor-usage#h7b3c950f25) と関連しています。__
 * - リッチエディタでは `picture` 要素は利用できません。
 */
export interface Props extends HTMLAttributes<'div'> {}

const { class: className, ...rest } = Astro.props;
const attrs: Record<string, unknown> = {
  ...rest,
};

if (!Astro.slots.has('default')) {
  throw new Error('Media: slotの中身が空です。');
}
---

<div
  class:list={[
    'Media',
    className,
  ]}
  {...attrs}
>
  {/* @slot このslotの直下では、クラス名無しの `figure` 要素の使用のみを許容します。 */}
  <slot />
</div>

<style>
  .Media {
    :where(figure) {
      display: flex;
      flex-direction: column;
      gap: calc(var(--user-spacing) * 2);
      align-items: center;
      width: fit-content;
      max-width: 100%;
      margin-inline: auto;

      &[style*='text-align: left'] {
        margin-left: 0;
        text-align: revert !important;
      }

      &[style*='text-align: right'] {
        margin-right: 0;
        text-align: revert !important;
      }

      :where(a) {
        display: flex;
        flex-direction: column;
        gap: calc(var(--user-spacing) * 2);
        align-items: center;
        color: var(--user-color-primary);
        text-decoration: none;
        fill: var(--user-color-primary);
      }

      :where(img) {
        display: block;
        max-width: 100%;
        height: auto;
      }

      :where(figcaption) {
        width: 0;
        min-width: 100%;
        font-size: var(--user-font-size-note);
        text-align: center;
      }
    }
  }

  @media (any-hover: hover) {
    .Media {
      :where(figure) {
        :where(a) {
          &:any-link {
            &:hover {
              text-decoration: underline;
              opacity: 0.5;
            }
          }
        }
      }
    }
  }
</style>

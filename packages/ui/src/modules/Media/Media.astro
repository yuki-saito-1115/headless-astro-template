---
import type { HTMLAttributes } from 'astro/types';

/**
 * - __このコンポーネントはmicroCMSのリッチエディタの [画像](https://document.microcms.io/manual/rich-editor-usage#h7b3c950f25) と関連しています。__
 */
export interface Props extends HTMLAttributes<'div'> {}

const { class: className, ...rest } = Astro.props;
const attrs: Record<string, unknown> = { ...rest };

if (!Astro.slots.has('default')) {
  throw new Error('Media: slotの中身が空です。');
}
---
<div
  class:list={['Media', className]}
  {...attrs}
>
  <slot />
</div>


<style>
  .Media {
    text-align: center;

    &:has(figure[style*="text-align: left"]) {
      text-align: left;
    }

    &:has(figure[style*="text-align: right"]) {
      text-align: right;
    }

    :where(figure),
    :where(a) {
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: calc(var(--user-spacing) * 2);
    }

    :where(figure) {
      max-width: 100%;
    }

    :where(a) {
      color: var(--user-color-primary);
      text-decoration: none;
      fill: var(--user-color-primary);
    }

    :where(img) {
      display: block;
      max-width: 100%;
      height: auto;
    }

    :where(figcaption) {
      width: 0;
      min-width: 100%;
      text-align: center;
      font-size: var(--user-font-size-note);
    }
  }

  @media (any-hover: hover) {
    .Media {
      :where(a) {
        &:any-link {
          &:hover {
            opacity: 0.5;
            text-decoration: underline;
          }
        }
      }
    }
  }
</style>

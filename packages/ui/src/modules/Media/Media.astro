---
import type { HTMLAttributes } from 'astro/types';

/**
 * - __このコンポーネントはmicroCMSのリッチエディタの [画像](https://document.microcms.io/manual/rich-editor-usage#h7b3c950f25) と関連しています。__
 */
export interface Props extends HTMLAttributes<'div'> {}

const { class: className, ...rest } = Astro.props;
const attrs: Record<string, unknown> = { ...rest };

if (!Astro.slots.has('default')) {
  throw new Error('Media: slotの中身が空です。');
}
---
<div
  class:list={['Media', className]}
  {...attrs}
>
  <slot />
</div>


<style>
  .Media {
    :where(figure) {
      align-items: center;
      display: flex;
      flex-direction: column;
      gap: calc(var(--user-spacing) * 2);
      margin-inline: auto;
      max-width: 100%;
      width: fit-content;

      &[style*='text-align: left'] {
        text-align: revert !important;
        margin-left: 0;
      }

      &[style*='text-align: right'] {
        text-align: revert !important;
        margin-right: 0;
      }

      :where(a) {
        align-items: center;
        color: var(--user-color-primary);
        display: flex;
        text-decoration: none;
        fill: var(--user-color-primary);
        flex-direction: column;
        gap: calc(var(--user-spacing) * 2);
      }

      :where(img) {
        display: block;
        height: auto;
        max-width: 100%;
      }

      :where(figcaption) {
        font-size: var(--user-font-size-note);
        min-width: 100%;
        text-align: center;
        width: 0;
      }
    }
  }

  @media (any-hover: hover) {
    .Media {
      :where(figure) {
        :where(a) {
          &:any-link {
            &:hover {
              opacity: 0.5;
              text-decoration: underline;
            }
          }
        }
      }
    }
  }
</style>

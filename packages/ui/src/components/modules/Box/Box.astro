---
import type { HTMLAttributes } from 'astro/types';
import type { CommonTypeHeading } from '../../../types/CommonType';

export interface BoxProps extends HTMLAttributes<'div' | 'details'> {
  element?: 'div' | 'details';
  scroll?: boolean;
  theme?: 'related' | 'important' | 'alert' | undefined;
  title?: string;
  titleElement?: CommonTypeHeading | 'summary';
}

const {
  element = 'div',
  scroll = false,
  theme = undefined,
  title = undefined,
  titleElement = 'div',
  class: className,
  ...rest
} = Astro.props;
const Element = element;
const TitleElement = element === 'details' ? 'summary' : titleElement;
const classList = ['Box'];
let mergedClass = '';

// undefined のときは theme- クラスを付けない
if (theme != null && theme !== '') {
  classList.push(`theme-${theme}`);
}

if (scroll === true) {
  classList.push('theme-scroll');
}

mergedClass = classList.join(' ');
---

<Element
  class:list={[mergedClass, className]}
  {...rest}
>
  {title && (
    <TitleElement class:list={['Box__head']}>
      <span class:list={['Box__title']}>{title}</span>
    </TitleElement>
  )}

  <div class:list={['Box__body']}>
    <slot />
  </div>
</Element>


<style>
  .Box {
    --local-foreground: var(--user-color-foreground-dark);
    --local-background: var(--color-gray-100);
    --local-outline: transparent;
    --local-padding: calc(var(--user-spacing) * 4);

    background-color: var(--local-background);
    border: 1px solid var(--local-outline);
    padding-bottom: var(--local-padding);
    padding-top: var(--local-padding);

    &:has(:where(.Box__head)) {
      padding-top: 0;
    }

    &:where(.theme-related) {
      --local-background: var(--user-color-background-light);
      --local-outline: var(--user-color-outline-dark);
    }

    &:where(.theme-important) {
      --local-background: var(--user-color-danger-light);
      --local-outline: transparent;
    }

    &:where(.theme-alert) {
      --local-foreground: var(--user-color-danger-dark);
      --local-background: var(--user-color-background-light);
      --local-outline: var(--user-color-danger-dark);

      > :where(.Box__head) {
        text-align: center;
      }
    }

    &:where(.theme-scroll) {
      > :where(.Box__body) {
        height: 200px;
        overflow: auto;
        position: relative;
      }
    }

    :where(.Box__head) {
      color: var(--local-foreground);
      padding: var(--local-padding);
    }

    :where(.Box__title) {
      font-weight: var(--user-font-weight-bold);
      font-size: var(--text-lg);
      line-height: var(--text-lg--line-height);
    }

    :where(.Box__body) {
      padding: 0 var(--local-padding);

      > :is(:first-child) {
        margin-top: 0;
      }

      > :is(:last-child) {
        margin-bottom: 0;
      }
    }
  }

  details.Box {
    padding-bottom: 0;

    > :where(.Box__head) {
      list-style: none;
      cursor: pointer;
      position: relative;

      /* icon */
      &::before {
        background-color: currentColor;
        content: '';
        display: block;
        height: 16px;
        mask-image: url('/assets/images/icons/plus.svg');
        mask-repeat: no-repeat;
        mask-size: cover;
        pointer-events: none;
        position: absolute;
        right: var(--local-padding);
        top: 50%;
        transform: translateY(-50%);
        width: 16px;
      }
    }

    &[open] {
      padding-bottom: var(--local-padding);

      > :where(.Box__head) {
        &::before {
          mask-image: url('/assets/images/icons/minus.svg');
        }
      }
    }
  }

  @media (width >= 768px) {
    .Box {
      --local-padding: calc(var(--user-spacing) * 8);

      :where(.Box__title) {
        font-size: var(--text-xl);
        line-height: var(--text-xl--line-height);
      }
    }
  }
</style>

---
import type { CommonTypeColumn } from '@type/CommonType';
import type { HTMLAttributes } from 'astro/types';

export interface ListPropType extends HTMLAttributes<'div'> {
  columnPc?: CommonTypeColumn;
  columnSp?: CommonTypeColumn;
}

const { columnPc = 1, columnSp = 1, class: className, ...rest } = Astro.props;
const classList = ['List'];

if (columnPc) {
  classList.push(`columnPc-${columnPc}`);
}

if (columnSp) {
  classList.push(`columnSp-${columnSp}`);
}

const mergedClass = classList.join(' ');
---

<div
  class:list={[mergedClass, className]}
  {...rest}
>
  <slot />
</div>


<style>
  .List {
    container-type: inline-size;

    :where(ul) {
      display: grid;
      padding-left: 2em;

      :where(li) {
        list-style: none;
        height: 100%;
        list-style: none;
        padding-left: 1.25em;
        position: relative;

        /* arrow */
        &::before {
          background-color: var(--user-color-primary);
          border-radius: 50%;
          content: '';
          display: block;
          height: 6px;
          left: 0;
          position: absolute;
          top: 0.75em;
          width: 6px;
        }

        > :is(:first-child) {
          margin-top: 0;
        }

        > :is(:last-child) {
          margin-bottom: 0;
        }
      }
    }
  }

  @container (max-width: 767.99px) {
    .List {
      :where(ul) {
        gap: calc(var(--user-spacing) * 2)  calc(var(--user-spacing) * 6);
        margin-top: calc(var(--user-spacing) * 2) !important;
      }

      &.columnSp-2 {
        :where(ul) {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      &.columnSp-3 {
        :where(ul) {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }

      &.columnSp-4 {
        :where(ul) {
          grid-template-columns: repeat(4, minmax(0, 1fr));
        }
      }

      &.columnSp-auto {
        :where(ul) {
          display: flex;
          flex-wrap: wrap;

          :where(li) {
            flex: 0 0 auto;
            max-width: 100%;
          }
        }
      }
    }
  }

  @container (min-width: 768px) {
    .List {
      :where(ul) {
        gap: calc(var(--user-spacing) * 2)  calc(var(--user-spacing) * 8);
        margin-top: calc(var(--user-spacing) * 2) !important;
      }

      &.columnPc-2 {
        :where(ul) {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      &.columnPc-3 {
        :where(ul) {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }

      &.columnPc-4 {
        :where(ul) {
          grid-template-columns: repeat(4, minmax(0, 1fr));
        }
      }

      &.columnPc-auto {
        :where(ul) {
          display: flex;
          flex-wrap: wrap;

          :where(li) {
            flex: 0 0 auto;
            max-width: 100%;
          }
        }
      }
    }
  }
</style>

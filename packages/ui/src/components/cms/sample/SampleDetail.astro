---
import Heading3 from '@components/modules/Heading3/Heading3.astro';
import type { SampleType } from '@scripts/build/microcms';
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'div'> {
  sample: SampleType | null;
  contentId?: string | null;
  draftKey?: string | null;
}

const { sample, contentId, draftKey, class: className, ...rest } = Astro.props;
const classList = ['SampleDetail'];
---

<div
  class:list={[classList, className]}
  {...rest}
>
  <Heading3 class="mt-10 md:mt-20">{sample?.title}</Heading3>

  <div class="mt-5 md:mt-10">{sample?.category}</div>

  <div class="mt-5 md:mt-10" set:html={sample?.content} />

  <div class="mt-5 md:mt-10"><a href={sample?.link} target="_blank">詳細はこちら</a></div>

  <a href={ contentId && draftKey ? `/sample?contentId=${contentId}&draftKey=${draftKey}` : `/sample` }>一覧に戻る</a>
</div>

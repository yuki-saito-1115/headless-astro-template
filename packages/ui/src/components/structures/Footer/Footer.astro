---
interface Props {
  siteName: string;
}

const { siteName } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <small>&copy; {year} {siteName}</small>
</footer>

<style>
  .site-footer {
    padding: 2rem 1.5rem;
    border-top: 1px solid #e5e7eb;
    color: #6b7280;
  }
</style>

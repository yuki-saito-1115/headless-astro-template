---
import type { HTMLAttributes } from 'astro/types';

export interface WrapPropsType extends HTMLAttributes<'div'> {}

const { class: className, ...rest } = Astro.props as WrapPropsType;
---

<div
  class:list={['Wrap', className]}
  {...rest}
>
  <slot />


  <style>
    .Wrap {
      display: grid;
      grid-template-areas: 'header' 'breadcrumb' 'mainVisual' 'content' 'navigationTop' 'footer';
      grid-template-rows: auto auto auto 1fr auto auto;
      min-height: 100vh;
      width: 100%;
    }
  </style>
</div>


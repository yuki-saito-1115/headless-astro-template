---
import type { HTMLAttributes } from 'astro/types';

export interface WrapPropsType extends HTMLAttributes<'div'> {}

const { class: className, ...rest } = Astro.props as WrapPropsType;
---

<div
  class:list={['Wrap', className]}
  {...rest}
>
  <slot />
</div>

<style>
  .Wrap {
    display: grid;
    grid-template-areas: 'previewNote' 'header' 'breadcrumb' 'mainVisual' 'content' 'navigationTop' 'footer';
    grid-template-rows: auto auto auto auto 1fr auto auto;
    min-height: 100vh;
    width: 100%;
  }
</style>


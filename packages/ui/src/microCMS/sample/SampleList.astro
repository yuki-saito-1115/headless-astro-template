---
import type { SampleType } from '@packages/content/build/microcms';
import type { HTMLAttributes } from 'astro/types';
import List from '../../modules/List/List.astro';

export interface Props extends HTMLAttributes<'div'> {
  samples: SampleType[];
  contentId?: string | null;
  draftKey?: string | null;
}

const { samples, contentId, draftKey, class: className, ...rest } = Astro.props;
const classList = ['SampleList'];
---

<div
  class:list={[classList, className]}
  {...rest}
>
  <List>
    <ul>
      {samples.map((sample) => (
        <li>
          <a href={`/sample/${sample.id ?? ''}${draftKey && sample.id === contentId ? `?draftKey=${encodeURIComponent(draftKey)}` : ''}`}>
            {sample.title ?? ''}
          </a>
        </li>
      ))}
    </ul>
  </List>
</div>

---
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'footer'> {}

const { class: className, ..._rest } = Astro.props as Props;
---

<footer
  class:list={[
    'Footer',
    className,
  ]}
  {..._rest}
>
  <div
    class:list={[
      'Footer__outer',
    ]}
  >
    <div
      class:list={[
        'Footer__inner',
      ]}
    >
      footer
    </div>
  </div>
</footer>

<style>
  .Footer {
    display: grid;
    grid-area: footer;
    grid-template-columns: 1fr minmax(var(--user-content-width-sp), var(--user-content-width-pc)) 1fr;
    gap: 0 var(--user-outside-gutter-sp);
    border-top: 1px solid var(--user-color-outline-dark);

    :where(.Footer__outer) {
      display: grid;
      grid-template-columns: 1fr minmax(var(--user-content-width-sp), var(--user-content-width-pc)) 1fr;
      grid-column: 1 / 4;
      gap: 0 var(--user-outside-gutter-sp);
    }

    :where(.Footer__inner) {
      grid-column: 2 / 3;
    }
  }

  @media (width >= 768px) {
    .Footer {
      gap: 0 var(--user-outside-gutter-pc);

      :where(.Footer__outer) {
        gap: 0 var(--user-outside-gutter-pc);
      }
    }
  }
</style>

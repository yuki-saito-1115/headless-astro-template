---
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'div'> {}

const { class: className, ..._rest } = Astro.props as Props;
---

<div
  class:list={[
    'NavigationTop',
    className,
  ]}
  {..._rest}
>
  <div
    class:list={[
      'NavigationTop__inner',
    ]}
  >
    <a href="#top">画面最上部へ戻る</a>
  </div>
</div>

<style>
  .NavigationTop {
    --local-button-size: calc(var(--user-spacing) * 10);
    position: sticky;

    bottom: 0;
    z-index: 200;
    grid-area: navigationTop;
    height: 0;
    pointer-events: none;

    :where(.NavigationTop__inner) {
      position: relative;
      display: flex;
      justify-content: flex-end;
      padding: calc(var(--user-spacing) * 4);
      pointer-events: none;
      transform: translateY(-100%);
    }

    :where(a) {
      position: relative;
      display: block;
      width: var(--local-button-size);
      height: var(--local-button-size);
      padding: var(--local-button-size) 0 0 var(--local-button-size);
      overflow: hidden;
      pointer-events: auto;
      background-color: var(--user-color-primary);
      border: 1px solid var(--user-color-primary);

      /* arrow */
      &::before {
        position: absolute;
        top: 0;
        left: 0;
        display: block;
        width: 100%;
        height: 100%;
        content: '';
        background-color: var(--user-color-foreground-light);
        mask-image: url('/assets/images/icons/angle-up.svg');
        mask-repeat: no-repeat;
        mask-position: center;
        mask-size: 50%;
      }
    }
  }

  @media (width >= 768px) {
    .NavigationTop {
      --local-button-size: calc(var(--user-spacing) * 12);
    }
  }

  @media (any-hover: hover) {
    .NavigationTop {
      :where(a) {
        &:hover {
          background-color: var(--user-color-background-light);
          border: 1px solid var(--user-color-primary);

          /* arrow */
          &::before {
            background-color: var(--user-color-primary);
          }
        }
      }
    }
  }
</style>

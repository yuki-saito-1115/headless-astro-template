---
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'header'> {}

const { class: className, ..._rest } = Astro.props as Props;
---

<header
  class:list={[
    'Header',
    className,
  ]}
  {..._rest}
>
  <div
    class:list={[
      'Header__outer',
    ]}
  >
    <div
      class:list={[
        'Header__inner',
      ]}
    >
      header
    </div>
  </div>
</header>

<style>
  .Header {
    display: grid;
    grid-area: header;
    grid-template-columns: 1fr minmax(var(--user-content-width-sp), var(--user-content-width-pc)) 1fr;
    gap: 0 var(--user-outside-gutter-sp);
    border-bottom: 1px solid var(--user-color-outline-dark);

    :where(.Header__outer) {
      display: grid;
      grid-template-columns: 1fr minmax(var(--user-content-width-sp), var(--user-content-width-pc)) 1fr;
      grid-column: 1 / 4;
      gap: 0 var(--user-outside-gutter-sp);
    }

    :where(.Header__inner) {
      grid-column: 2 / 3;
    }
  }

  @media (width >= 768px) {
    .Header {
      gap: 0 var(--user-outside-gutter-pc);

      :where(.Header__outer) {
        gap: 0 var(--user-outside-gutter-pc);
      }
    }
  }
</style>

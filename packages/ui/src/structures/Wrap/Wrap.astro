---
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'div'> {}

const { class: className, ...rest } = Astro.props as Props;
const slotHtml = await Astro.slots.render('default');
---

<div
  class:list={[
    'Wrap',
    className,
  ]}
  {...rest}
>
  {slotHtml && <Fragment set:html={slotHtml} />}
</div>

<style>
  .Wrap {
    display: grid;
    grid-template-areas: 'previewNote' 'header' 'breadcrumb' 'mainVisual' 'content' 'navigationTop' 'footer';
    grid-template-rows: auto auto auto auto 1fr auto auto;
    width: 100%;
    min-height: 100vh;
  }
</style>

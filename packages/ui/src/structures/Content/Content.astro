---
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'main'> {}

const { class: className, ..._rest } = Astro.props;
const slotHtml = await Astro.slots.render('default');
---

<main
  class:list={[
    'Content',
    className,
  ]}
  {..._rest}
>
  {slotHtml && <Fragment set:html={slotHtml} />}
</main>

<style>
  .Content {
    grid-area: content;
  }
</style>

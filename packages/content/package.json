    "./types/*": "./src/types/*.ts"
  },
  "scripts": {
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "astro": "^7.3.3",
    "microcms-js-sdk": "^3.5.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@storybook-astro/renderer": "^1.12.0",
    "typescript": "^5.9.3"
  }

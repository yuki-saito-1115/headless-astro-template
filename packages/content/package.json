{
  "name": "@packages/content",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./build/*": "./src/scripts/build/*.ts",
    "./plugins/vite/*": {
      "types": "./src/plugins/vite/*.d.ts",
      "default": "./src/plugins/vite/*.js"
    },
    "./runtime/swiper/types": "./src/scripts/runtime/swiper/types/public.d.ts",
    "./runtime/swiper/*": "./src/scripts/runtime/swiper/*",
